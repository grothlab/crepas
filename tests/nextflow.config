/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// TODO nf-core: Specify any additional parameters here
// Or any resources requirements
params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/crepas/'
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true

// modules_testdata_base_path is test-only and not in nextflow_schema.json; without this,
// pipeline-level tests fail validation (validation.logging.unrecognisedParams = "error")
validation.ignoreParams = ['modules_testdata_base_path']

// Cap resource requests to what the GitHub-hosted runners provide (4 CPUs, ~16 GB)
process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

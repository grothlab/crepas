process {
    withName: 'DEEPTOOLS_PLOTFINGERPRINT' {
        ext.prefix = {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.multimap_allocation_method ? '.' + params.multimap_allocation_method : ''}" +
            "${meta.exp_type == 'ATAC-seq' ? '.shifted' : ''}" +
            "${!params.skip_flT3 ? '.flT3' : ''}" +
            "${meta.flTbl_total_mapped_reads ? !meta.single_end ? '.flTbl.rmO' : '.flTbl' : ''}" +
            "${meta.downsampling_method ? '.dSp_' + meta.downsampling_method : ''}" +
            "${(meta.downsampling_method && meta.is_input_control) ? '_ref_' + meta.input_control_of_antibody : ''}"
        }
        ext.args   = { [
            '--skipZeros',
            "--numberOfSamples ${params.fingerprint_bins}",
            "--labels ${meta.id} ${meta.input_control}"
        ].join(' ').trim() }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.multimap_allocation_method ? params.multimap_allocation_method == 'chromap' ? 'cm_allo' : params.multimap_allocation_method : ''}" +
                "/${meta.exp_type}/plotFingerprint" 
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

process {
    withName: 'EDD' {
        // TODO: this errorStrategy is to skip when the bin size cannot be estimated (when it is not specified)
        errorStrategy = { task.exitStatus == 1 ? 'ignore' : 'terminate' }
        ext.prefix = {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.multimap_allocation_method ? '.' + params.multimap_allocation_method : ''}" +
            "${meta.exp_type == 'ATAC-seq' ? '.shifted' : ''}" +
            "${!params.skip_flT3 ? '.flT3' : ''}" +
            "${meta.flTbl_total_mapped_reads ? !meta.single_end ? '.flTbl.rmO' : '.flTbl' : ''}" +
            "${meta.downsampling_method ? '.dSp_' + meta.downsampling_method : ''}" +
            "${(meta.downsampling_method && meta.is_input_control) ? '_ref_' + meta.input_control_of_antibody : ''}"
        }
        ext.args  = { [
            params.edd_bin_size ? "--bin-size ${params.edd_bin_size}" : "",
            params.edd_gap_penalty ? "--gap-penalty ${params.edd_gap_penalty}" : "",
            "--num-trials ${params.edd_num_trials}",
            "--fdr ${params.edd_fdr}",
            "--write-log-ratios",
            "--write-bin-scores"
        ].join(' ').trim() }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.multimap_allocation_method ? params.multimap_allocation_method == 'chromap' ? 'cm_allo' : params.multimap_allocation_method : ''}" +
                "/${meta.exp_type}/edd/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

process {
    withName: 'GROTHLAB_GLSEQ:GLSEQ:SAMTOOLS_STATS_SUMMARY:SAMTOOLS_STATS_TRANSPOSE' {
        publishDir = [ 
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.multimap_allocation_method ? params.multimap_allocation_method == 'chromap' ? 'cm_allo' : params.multimap_allocation_method : ''}" +
                "/samtools_stats_summary/transposed"
            },
            mode: params.publish_dir_mode,
            pattern: "*.tsv",
            enabled: false
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:SAMTOOLS_STATS_SUMMARY:SAMTOOLS_STATS_CAT' {
        ext.prefix = { "samtools_stats_summary${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.flT2' : ''}${params.multimap_allocation_method ? '.' + params.multimap_allocation_method : ''}${meta.exp_type == 'ATAC-seq' ? '.shifted' : ''}${!params.skip_flT3 ? '.flT3' : ''}${params.bam_downsampling_method ? '.dSp' : '' }" }
        publishDir = [ 
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.multimap_allocation_method ? params.multimap_allocation_method == 'chromap' ? 'cm_allo' : params.multimap_allocation_method : ''}" +
                "/samtools_stats_summary/"
            },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:SAMTOOLS_STATS_SUMMARY:FINAL_STAT_SUMMARY' {
        ext.prefix = { "final_samtools_stats_summary${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.flT2' : ''}${params.multimap_allocation_method ? '.' + params.multimap_allocation_method : ''}${meta.exp_type == 'ATAC-seq' ? '.shifted' : ''}${!params.skip_flT3 ? '.flT3' : ''}${params.bam_downsampling_method ? '.dSp' : '' }" }
        publishDir = [ 
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.multimap_allocation_method ? params.multimap_allocation_method == 'chromap' ? 'cm_allo' : params.multimap_allocation_method : ''}" +
                "/samtools_stats_summary/"
            },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }
}

process {
    withName: 'IGV' {
        publishDir = [
            [
                path: { 
                    "${params.outdir}/igv/" +
                    "${params.multimap_allocation_method ? params.multimap_allocation_method == 'chromap' ? 'cm_allo' : params.multimap_allocation_method : ''}/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}"
                },
                mode: params.publish_dir_mode,
                pattern: '*.{txt,xml}'
            ],
            [
                path: { "${params.outdir}/genome" },
                mode: params.publish_dir_mode,
                pattern: '*.{fa,fasta}'
            ]
        ]
    }
}

process {
    withName: 'MULTIQC' {
        ext.args   = params.multiqc_title ? "--title \"$params.multiqc_title\"" : ''
        publishDir = [
            path: { 
                    "${params.outdir}/multiqc/" +
                    "${params.multimap_allocation_method ? params.multimap_allocation_method == 'chromap' ? 'cm_allo' : params.multimap_allocation_method : ''}/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}"
                },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

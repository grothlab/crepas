// Here are all the subworkflows included by the entry workflow
includeConfig "../../subworkflows/local/fastq_fastqc_umitools_umitransfer_trimgalore/nextflow.config"
includeConfig "../../subworkflows/nf-core/fastq_align_bwa/nextflow.config"
includeConfig "../../subworkflows/local/fastq_align_bwamem2/nextflow.config"
includeConfig "../../subworkflows/nf-core/fastq_align_bowtie2/nextflow.config"
includeConfig "../../subworkflows/local/fastq_align_strobealign/nextflow.config"
includeConfig "../../subworkflows/local/fastq_align_bowtie/nextflow.config"
includeConfig "../../subworkflows/nf-core/fastq_align_chromap/nextflow.config"
includeConfig "../../subworkflows/nf-core/fastq_align_star/nextflow.config"
includeConfig "../../subworkflows/nf-core/fastq_align_hisat2/nextflow.config"
includeConfig "../../subworkflows/local/fastq_align_minimap2/nextflow.config"
includeConfig "../../subworkflows/nf-core/bam_dedup_umi/nextflow.config"
includeConfig "../../subworkflows/nf-core/bam_markduplicates_picard/nextflow.config"
includeConfig "../../subworkflows/local/spikein_barcodes/nextflow.config"
includeConfig "../../subworkflows/local/bam_filter_sambamba_rmo_stats/nextflow.config"
includeConfig "../../subworkflows/local/bam_spikein_split/nextflow.config"
includeConfig "../../subworkflows/local/bam_allocate_multimappers/nextflow.config"
includeConfig "../../subworkflows/local/bam_shift_reads/nextflow.config"
includeConfig "../../subworkflows/local/bam_downsample/nextflow.config"
includeConfig "../../subworkflows/local/bam_normalize_bigwig_deeptools/nextflow.config"
includeConfig "../../subworkflows/local/te_counting/nextflow.config"
includeConfig "../../subworkflows/local/bam_peaks_call_qc_annotate_consenrich_rocco_homer/nextflow.config"
includeConfig "../../subworkflows/local/bam_peaks_call_qc_annotate_epic2_homer/nextflow.config"
includeConfig "../../subworkflows/local/bam_peaks_call_qc_annotate_seacr_homer/nextflow.config"
includeConfig "../../subworkflows/local/bam_peaks_call_qc_annotate_danpos2_homer/nextflow.config"
includeConfig "../../subworkflows/local/bam_peaks_call_qc_annotate_macs3_homer/nextflow.config"
includeConfig "../../subworkflows/local/bam_peaks_call_qc_annotate_genrich_homer/nextflow.config"

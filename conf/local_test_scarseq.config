/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run grothlab/glseq -profile ku_sund_danhead,local_test_scarseq --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    
    config_profile_contact      = 'Samuel Ruiz-Pérez <samuel.perez@cpr.ku.dk>'
    config_profile_name         = 'SCAR-seq test profile'
    config_profile_description  = 'Test dataset to check SCAR-seq analysis functions of the pipeline (for DAN System users)'

    // Input data
    input                       = params.local_testdata_base_path + 'samplesheets/local_test_scarseq_samplesheet.csv'

    // Genome references
    aligner                         = 'chromap'
    chromap_index                   = params.local_testdata_base_path + 'references/Mus_musculus/GRCm39/spiked/GRCm39_dm6/indices/chromap_0.2.6_index/GRCm39_dm6.primary_assembly.genome.index'
    fasta                           = params.local_testdata_base_path + 'references/Mus_musculus/GRCm39/spiked/GRCm39_dm6/genome/fasta/GRCm39_dm6.primary_assembly.genome.fa'
    gtf                             = params.local_testdata_base_path + 'references/Mus_musculus/GRCm39/annotations/transcript_models/gtf/gencode.vM36.primary_assembly.annotation.gtf'
    okseq_rfd_file                  = params.local_testdata_base_path + 'references/Mus_musculus/GRCm39/external_data/Replication/Okazaki_seq/rfd_files/OKseq_RFD_mESC_SRR7535256_r1_R1.csorted.mLb.mkD.flT1.flT3.GRCm39_SE_smooth_results_w1000_s30_d30_z1.bed.gz'
    initiation_zones                = params.local_testdata_base_path + 'references/Mus_musculus/GRCm39/external_data/Replication/Okazaki_seq/bed_files/OKseq_RFD_mESC_SRR7535256_r1_R1.csorted.mLb.mkD.flT1.flT3_Initiation_Zones_filtered.bed.gz'
    blacklist                       = params.local_testdata_base_path + 'references/Mus_musculus/GRCm39/annotations/blacklists/GRCm39.ExcludeRanges.Boyle.Excludable_v2.bed.gz'
    genome                          = 'GRCm39'
    spikein_genome                  = 'dm6'
    partition_exclude_chromosomes   = "chrX,chrY,chrM,GL456210.1, GL456211.1, GL456212.1, GL456219.1, GL456221.1, GL456233.2, GL456239.1, GL456354.1, GL456359.1, GL456360.1, GL456366.1, GL456367.1, GL456368.1, GL456370.1, GL456372.1, GL456378.1, GL456379.1, GL456381.1, GL456382.1, GL456383.1, GL456385.1, GL456387.1, GL456389.1, GL456390.1, GL456392.1, GL456394.1, GL456396.1, JH584295.1, JH584296.1, JH584297.1, JH584298.1, JH584299.1, JH584300.1, JH584301.1, JH584302.1, JH584303.1, JH584304.1, MU069434.1, MU069435.1"
    
    // Other parameters
    skip_umi_extract            = false
    with_umi                    = true
    save_align_intermeds        = true
    save_spikein_intermeds      = true
    save_partition_intermeds      = true

    // For speed to avoid CI time-out
    fingerprint_bins            = 200
    skip_plot_profile           = true
}
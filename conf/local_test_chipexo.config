/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run grothlab/glseq -profile ku_sund_danhead,test_chipexo --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {

    config_profile_contact      = 'Samuel Ruiz-Pérez <samuel.perez@cpr.ku.dk>'
    config_profile_name         = 'ChIP-exo test profile (for DAN System users)'
    config_profile_description  = 'Test dataset to check ChIP-exo analysis functions of the pipeline (for DAN System users)'

    // Input data
    input                       = params.local_testdata_base_path + 'samplesheets/local_test_chipexo_samplesheet.csv'
    read_length                 = 50

    // Genome references
    aligner                     = 'chromap'
    chromap_index               = params.local_testdata_base_path + 'references/Mus_musculus/GRCm38/indices/chromap_0.2.6_index/GRCm38.primary_assembly.genome.index'
    fasta                       = params.local_testdata_base_path + 'references/Mus_musculus/GRCm38/genome/fasta/GRCm38.primary_assembly.genome.fa.gz'
    gtf                         = params.local_testdata_base_path + 'references/Mus_musculus/GRCm38/annotations/transcript_models/gtf/gencode.vM25.primary_assembly.annotation.gtf.gz'
    blacklist                   = params.local_testdata_base_path + 'references/Mus_musculus/GRCm38/annotations/blacklists/bed/GRCm38.ENCODE_ENCFF999QPV.Kundaje.unified_Excludable.bed.gz'
    genome                      = 'GRCm38'

    // Other parameters
    trim_full_length            = false
    trim_nextseq                = 0
    trim_q_cutoff               = 20
    save_align_intermeds        = true
    save_spikein_intermeds      = true

    // For speed to avoid CI time-out
    fingerprint_bins            = 200
    skip_plot_profile           = true

}
/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run grothlab/glseq -profile ku_sund_danhead,local_test_chipseq --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {

    config_profile_contact      = 'Samuel Ruiz-Pérez <samuel.perez@cpr.ku.dk>'
    config_profile_name         = 'ChIP-seq test profile (for DAN System users)'
    config_profile_description  = 'Test dataset to check ChIP-seq analysis functions of the pipeline (for DAN System users)'

    // Input data
    input                       = params.local_testdata_base_path + 'samplesheets/local_test_chipseq_samplesheet.csv'
    read_length                 = 50

    // Genome references
    aligner                     = 'chromap'
    chromap_index               = params.local_testdata_base_path + 'references/Homo_sapiens/GRCh38/spiked/GRCh38_dm6/indices/chromap_0.2.6_index/GRCh38_dm6.primary_assembly.genome.index'
    fasta                       = params.local_testdata_base_path + 'references/Homo_sapiens/GRCh38/spiked/GRCh38_dm6/genome/fasta/GRCh38_dm6.primary_assembly.genome.fa.gz'
    gtf                         = params.local_testdata_base_path + 'references/Homo_sapiens/GRCh38/annotations/transcript_models/gtf/gencode.v47.annotation.gtf.gz'
    blacklist                   = params.local_testdata_base_path + 'references/Homo_sapiens/GRCh38/annotations/blacklists/bed/GRCh38.ENCODE_ENCFF419RSJ.Kundaje.Excludable.bed.gz'
    genome                      = 'GRCh38'
    spikein_genome              = 'dm6'

    bam_downsampling_method     = 'min_endo_by_type'
    downsampling_endo_threshold = 500000
    downsampling_exo_threshold  = 30000
    skip_te_counting            = false
    skip_telocal                = false
    te_gtf                      = params.local_testdata_base_path + 'references/Homo_sapiens/GRCh38/annotations/repeats/gtf/GRCh38_GENCODE_rmsk_TE.gtf.gz'

    // Other parameters
    skip_umi_extract            = false
    with_umi                    = true
    save_align_intermeds        = true
    save_spikein_intermeds      = true

    // For speed to avoid CI time-out
    fingerprint_bins            = 200
    skip_plot_profile           = true

}
/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run grothlab/crepas -profile test_chipexo,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    cache = 'lenient'
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {

    config_profile_contact      = 'Samuel Ruiz-Pérez <samper@cancer.dk>'
    config_profile_name         = 'ChIP-exo test profile'
    config_profile_description  = 'Test dataset to check ChIP-exo analysis functions of the pipeline'

    // Input data
    input       = params.crepas_testdata_base_path + 'samplesheet/v1.0.0/samplesheet_test_chipexo.csv'
    read_length = 50

    // Genome references
    genome          = 'mm10'
    fasta           = params.igenomes_base + '/Mus_musculus/UCSC/mm10/Sequence/WholeGenomeFasta/genome.fa'
    gtf             = params.igenomes_base + '/Mus_musculus/UCSC/mm10/Annotation/Genes/genes.gtf'
    skip_flTbl      = true

    // Other parameters
    trim_full_length            = false
    trim_nextseq                = 0
    trim_q_cutoff               = 20

    // For speed to avoid CI time-out
    fingerprint_bins            = 200
    skip_genes_plotprofile       = true

}

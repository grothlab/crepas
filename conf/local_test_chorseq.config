/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run grothlab/glseq -profile ku_sund_danhead,local_test_chorseq --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {

    config_profile_contact      = 'Samuel Ruiz-Pérez <samuel.perez@cpr.ku.dk>'
    config_profile_name         = 'ChOR-seq test profile (for DAN System users)'
    config_profile_description  = 'Test dataset to check ChOR-seq analysis functions of the pipeline (for DAN System users)'

    // Input data
    input                       = params.local_testdata_base_path + 'samplesheets/local_test_chorseq_samplesheet.csv'
    read_length                 = 50

    // Genome references
    aligner                     = 'chromap'
    chromap_index               = params.local_testdata_base_path + 'references/Mus_musculus/GRCm38/spiked/GRCm38_dm6/indices/chromap_0.2.6_index/GRCm38_dm6.primary_assembly.genome.index'
    fasta                       = params.local_testdata_base_path + 'references/Mus_musculus/GRCm38/spiked/GRCm38_dm6/genome/fasta/GRCm38_dm6.primary_assembly.genome.fa.gz'
    gtf                         = params.local_testdata_base_path + 'references/Mus_musculus/GRCm38/annotations/transcript_models/gtf/gencode.vM25.primary_assembly.annotation.gtf.gz'
    blacklist                   = params.local_testdata_base_path + 'references/Mus_musculus/GRCm38/annotations/blacklists/bed/GRCm38.ENCODE_ENCFF999QPV.Kundaje.unified_Excludable.bed.gz'
    genome                      = 'mm10'
    spikein_genome              = 'dm6'
    
    bam_downsampling_method     = 'min_endo_by_type'
    downsampling_endo_threshold = 500000
    downsampling_exo_threshold  = 30000
    skip_te_counting            = false
    skip_telocal                = false
    te_gtf                      = params.local_testdata_base_path + 'references/Mus_musculus/GRCm38/annotations/repeats/gtf/GRCm38_GENCODE_rmsk_TE.gtf.gz'
    tecount_te_index            = params.local_testdata_base_path + 'references/Mus_musculus/GRCm39/annotations/repeats/indices/TE_TEcount/GRCm39_GENCODE_rmsk_TE.gtf.ind.gz'
    telocal_te_index            = params.local_testdata_base_path + 'references/Mus_musculus/GRCm39/annotations/repeats/indices/TE_TElocal/GRCm39_GENCODE_rmsk_TE.gtf.locInd.gz'

    // Other parameters
    narrow_peak                 = true
    skip_umi_extract            = false
    with_umi                    = true
    save_align_intermeds        = true
    save_spikein_intermeds      = true

    // For speed to avoid CI time-out
    fingerprint_bins            = 200
    skip_plot_profile           = true
}
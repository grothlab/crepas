/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run grothlab/crepas -profile test_repliseq,<docker/singularity> --outdir <OUTDIR>

    NOTE:
    The samplesheet covers early, mid and late S-phase fractions of two conditions. The RT track
    is an early/late ratio, so the mid fractions are aligned, filtered and turned into coverage
    tracks, but do not contribute to it.

----------------------------------------------------------------------------------------
*/

process {
    cache = 'lenient'
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {

    config_profile_contact      = 'Samuel Ruiz-Pérez <samper@cancer.dk>'
    config_profile_name         = 'Repli-seq test profile'
    config_profile_description  = 'Test dataset to check Repli-seq analysis functions of the pipeline'

    // Input data
    input                   = params.crepas_testdata_base_path + 'samplesheet/v1.0.0/samplesheet_test_repliseq.csv'

    // Genome references
    genome              = 'mm10'
    aligner             = 'bowtie2'
    fasta               = params.igenomes_base + '/Mus_musculus/UCSC/mm10/Sequence/WholeGenomeFasta/genome.fa'
    gtf                 = params.igenomes_base + '/Mus_musculus/UCSC/mm10/Annotation/Genes/genes.gtf'
    bowtie2_index       = params.igenomes_base + '/Mus_musculus/UCSC/mm10/Sequence/Bowtie2Index/'
    skip_flTbl          = true

    // Repli-seq samples carry no antibody, so there is nothing to call peaks on
    skip_peak_calling           = true

    // For speed to avoid CI time-out
    fingerprint_bins            = 200
}

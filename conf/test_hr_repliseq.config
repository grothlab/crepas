/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run grothlab/crepas -profile test_hr_repliseq,<docker/singularity> --outdir <OUTDIR>

    NOTE:
    The samplesheet covers H1 human embryonic stem cells twice over, so that one run exercises
    both Repli-seq designs and the plots that compare them:

      - 16-fraction high-resolution Repli-seq (S1..S16) plus the G1 whole-genome-sequencing
        control from the same experiment, from Zhao, Sasaki & Gilbert (2020, Genome Biology
        21:76, https://doi.org/10.1186/s13059-020-01983-8), read from ENA (SRR10150004-20).

      - Early/late Repli-seq of the same cell line, two biological replicates each, from the
        4D Nucleome open data portal (https://data.4dnucleome.org): accessions 4DNFIVJP3AYA,
        4DNFIJLCP2D2, 4DNFIZUZHKUP (early) and 4DNFIGIS77SL, 4DNFIPBQPYG5, 4DNFIPL7BXYA (late).
        The second biological replicate of each fraction is split over two runs, which the
        pipeline merges as technical replicates.

----------------------------------------------------------------------------------------
*/

process {
    cache = 'lenient'
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {

    config_profile_contact      = 'Samuel Ruiz-Pérez <samper@cancer.dk>'
    config_profile_name         = 'High-resolution Repli-seq test profile'
    config_profile_description  = 'Test dataset to check high-resolution (16-fraction) Repli-seq analysis functions of the pipeline'

    // Input data
    input                   = params.crepas_testdata_base_path + 'samplesheet/v1.0.0/samplesheet_test_hr_repliseq.csv'

    // Genome references
    genome              = 'hg38'
    aligner             = 'bowtie2'
    fasta               = params.igenomes_base + '/Homo_sapiens/UCSC/hg38/Sequence/WholeGenomeFasta/genome.fa'
    gtf                 = params.igenomes_base + '/Homo_sapiens/UCSC/hg38/Annotation/Genes/genes.gtf'
    bowtie2_index       = params.igenomes_base + '/Homo_sapiens/UCSC/hg38/Sequence/Bowtie2Index/'
    read_length         = 50
    skip_flTbl          = true

    skip_peak_calling           = true

    hr_repliseq_bin_size        = 50000
    hr_repliseq_exclude_chromosomes = 'chrX,chrY,chrM'

    // Pinned so the MultiQC heatmap is the same chromosome on every run
    hr_repliseq_mqc_chromosome  = 'chr1'

    // For speed to avoid CI time-out
    fingerprint_bins            = 200
}

/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.

    Use as follows:
        nextflow run grothlab/crepas -profile test_cutandrun,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    cache = 'lenient'
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {

    config_profile_contact      = 'Samuel Ruiz-Pérez <samper@cancer.dk>'
    config_profile_name         = 'CUT&RUN test profile'
    config_profile_description  = 'Test dataset to check CUT&RUN analysis functions of the pipeline'

    // Input data
    input                       = params.crepas_testdata_base_path + 'samplesheet/v1.0.0/samplesheet_test_cutandrun.csv'
    read_length                 = 100
    fragment_size               = 150
    coverage_extend_reads       = 250
    coverage_bin_size           = 250
    macs_extsize                = 150
    trim_full_length            = false


    // Genome references
    genome          = 'GRCh38'
    aligner         = "bowtie2"
    fasta           = params.igenomes_base + '/Homo_sapiens/NCBI/GRCh38/Sequence/WholeGenomeFasta/genome.fa'
    gtf             = params.igenomes_base + '/Homo_sapiens/NCBI/GRCh38/Annotation/Genes/genes.gtf'
    bowtie2_index   = params.igenomes_base + '/Homo_sapiens/NCBI/GRCh38/Sequence/Bowtie2Index/'
    skip_flTbl      = true


    // For speed to avoid CI time-out
    fingerprint_bins        = 2000
    skip_genes_plotprofile  = true

}

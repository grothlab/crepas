                enabled: params.save_spikein_intermeds
            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_SPIKEIN_SPLIT:SAMTOOLS_INDEX' {
            publishDir = [
                path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split" },
                mode: params.publish_dir_mode,
                pattern: '*.{bai,csi,crai}',
                enabled: params.save_spikein_intermeds
            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_SPIKEIN_SPLIT:SAMBAMBA_VIEW' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1.${meta.genome}.flT2" }
            ext.args = {
                [

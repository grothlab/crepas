        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_SHIFT_READS:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/alignmentsieve" },
            mode: params.publish_dir_mode,
            pattern: '*.{bai,csi,crai}',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_SHIFT_READS:BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:SAMTOOLS_.*' {
        ext.prefix =  {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
            "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
            ".sorted"
        }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/alignmentsieve" },
            mode: params.publish_dir_mode,
            pattern: "*.{stats,flagstat,idxstats}",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}


process {
    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_FILTER_SAMBAMBA_FLT3:SAMBAMBA_VIEW' {
        ext.prefix = { 
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
            "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
            ".flT3"
        }
        // See https://bioinformatics.stackexchange.com/a/519 for some details on the filter
        ext.args = {
            [
                params.aligner == 'star' ? 
                    meta.single_end ? "-F 'mapping_quality >= 255 and not (unmapped or secondary_alignment)'" :
                        "-F 'paired and proper_pair and mapping_quality >= 255 and not (unmapped or mate_is_unmapped or secondary_alignment)'" :
                params.aligner == 'bwa' ?
                    meta.single_end ? "-F 'mapping_quality >= 30 and not (unmapped or secondary_alignment) and not ([XA] != null or [SA] != null)'" :
                        "-F 'paired and proper_pair and mapping_quality >= 30 and not (unmapped or mate_is_unmapped or secondary_alignment) and not ([XA] != null or [SA] != null)'" :
                meta.single_end ? "-F 'mapping_quality >= 30 and not (unmapped or secondary_alignment)'" :
                    "-F 'paired and proper_pair and mapping_quality >= 30 and not (unmapped or mate_is_unmapped or secondary_alignment)'",
                "--format bam"
            ].join(' ').trim()
        }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/flT3" 
            },
            mode: params.publish_dir_mode,
            pattern: '*.bam',
            saveAs: { (meta.single_end || params.save_align_intermeds) ? "${it}" : null }
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_FILTER_SAMBAMBA_FLT3:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
        ext.prefix = { 
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
            "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
            ".flT3" +
            ".sorted"
        }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/flT3" 
            },
            mode: params.publish_dir_mode,
            pattern: '*.bam'
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_FILTER_SAMBAMBA_FLT3:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_INDEX' {
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/flT3" 
            },
            mode: params.publish_dir_mode,
            pattern: '*.{bai,csi,crai}'
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_FILTER_SAMBAMBA_FLT3:BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:.*' {
        ext.prefix = { 
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
            "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
            ".flT3" +
            ".sorted"
        }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/flT3" 
            },
            mode: params.publish_dir_mode,
            pattern: "*.{stats,flagstat,idxstats}"
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_FLAGSTAT_MAPPED_FLT3' {
        ext.prefix = { 
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
            "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
            ".flT3" +
            ".total_reads"
        }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/flT3" 
            },
            mode: params.publish_dir_mode,
            pattern: "*.txt",
            enabled: false,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}

if (!params.skip_picard_metrics) {
    process {
        withName: 'PICARD_COLLECTMULTIPLEMETRICS' {
            ext.args   = '--VALIDATION_STRINGENCY LENIENT --TMP_DIR tmp'
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3" }
            publishDir = [
                [
                    path: { 
                        "${params.outdir}/${params.aligner}/mergedLibrary/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                        "/picard_metrics" 
                    },
                    mode: params.publish_dir_mode,
                    pattern: "*_metrics"
                ],
                [
                    path: { 
                        "${params.outdir}/${params.aligner}/mergedLibrary/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                        "/picard_metrics/pdf" 
                    },
                    mode: params.publish_dir_mode,
                    pattern: "*.pdf"
                ]
            ]
        }
    }
}

if (!params.skip_spp) {
    process {
        withName: 'PHANTOMPEAKQUALTOOLS' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}" }
            ext.args   = { "--max-ppsize=500000" }
            ext.args2  = { "-p=$task.cpus -rf" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/phantompeakqualtools" 
                },
                mode: params.publish_dir_mode,
                pattern: "*.{out,pdf}"
            ]
        }

        withName: 'MULTIQC_CUSTOM_PHANTOMPEAKQUALTOOLS' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/phantompeakqualtools" 
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}

process {
    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_NORMALIZE_BIGWIG_DEEPTOOLS:DEEPTOOLS_BAMCOVERAGE_BINS' {
        ext.prefix = {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
            ".flT3" +
            "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
            "${params.coverage_bin_size ? '.' + params.coverage_bin_size : ''}" +
            ".${meta.norm_factor_type}"
        }
        // TODO: the blacklist should be inputted to the process directly, which is not possible in the current nf-core implementation
        // params.blacklist ? "--blackListFileName ${params.blacklist}" : "",
        ext.args = { [
            params.coverage_extend_reads ? "--extendReads ${params.coverage_extend_reads}" : "",
            params.coverage_bin_size ? "--binSize ${params.coverage_bin_size}" : "",
            "--scaleFactor ${meta.norm_factor_val}",
            "--outFileFormat bedgraph"
        ].join(' ').trim() }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/${meta.exp_type}" +
                "/coverage/" +
                "${meta.norm_factor_type}"
            },
            mode: params.publish_dir_mode,
            pattern: "*.bedgraph",
            enabled: params.save_coverage_intermeds,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_NORMALIZE_BIGWIG_DEEPTOOLS:BEDTOOLS_MAKEWINDOWS_(ENDO|EXO)' {
        ext.args   = { [
            "-w ${params.coverage_bin_size}"
        ].join(' ').trim() }
        ext.prefix = { "${meta.genome}.windows" }
        publishDir = [
            path: { 
                    "${params.outdir}/genome/norm_windows"
                },
            mode: params.publish_dir_mode,
            pattern: "*.bed",
            enabled: params.save_coverage_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_NORMALIZE_BIGWIG_DEEPTOOLS:BEDTOOLS_MAP_(ENDO|EXO)' {
        ext.prefix = {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
            ".flT3" +
            "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
            "${params.coverage_bin_size ? '.' + params.coverage_bin_size : ''}" +
            ".${meta.norm_factor_type}" +
            ".map" 
        }
        ext.args = { [
            "-c 4",
            "-o max"
        ].join(' ').trim() }
        publishDir = [
            path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}" +
                    "/coverage/" +
                    "${meta.norm_factor_type}"
                },
            mode: params.publish_dir_mode,
            pattern: "*.bed",
            enabled: params.save_coverage_intermeds,
            saveAs: { filename -> 
                if (filename.equals('versions.yml')) {
                    return null
                } else {
                    // Replace the extension with .bedgraph
                    return filename.replaceAll(/\.bed$/, '.bedgraph')
                }
            }
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_NORMALIZE_BIGWIG_DEEPTOOLS:BEDGRAPH_NORMALIZE' {
        ext.prefix = {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
            ".flT3" +
            "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
            "${params.coverage_bin_size ? '.' + params.coverage_bin_size : ''}" +
            ".${meta.norm_factor_type}"
        }
        ext.args2 = { [
            "--norm_factor ${meta.norm_factor_val}"
        ].join(' ').trim() }
        publishDir = [
            path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}" +
                    "/coverage/" +
                    "${meta.norm_factor_type}"
                },
            mode: params.publish_dir_mode,
            pattern: "*.bedgraph",
            enabled: params.save_coverage_intermeds,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_NORMALIZE_BIGWIG_DEEPTOOLS:BEDGRAPH_SIGNAL_OVER_INPUT' {
        ext.prefix = {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
            ".flT3" +
            "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
            "${params.coverage_bin_size ? '.' + params.coverage_bin_size : ''}" +
            ".${meta.norm_factor_type}" +
            ".soi" 
        }
        ext.args2 = { [
            params.soi_min_count > 0 ? "--min_count ${params.soi_min_count}" : "--min_count 1",
        ].join(' ').trim() }
        publishDir = [
            path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}" +
                    "/coverage/" +
                    "${meta.norm_factor_type}" +
                    "/cisrpm_soi/"
                },
            mode: params.publish_dir_mode,
            pattern: "*.bedgraph",
            enabled: params.save_coverage_intermeds,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_NORMALIZE_BIGWIG_DEEPTOOLS:BEDGRAPH_SORT' {
        ext.prefix = { 
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
            ".flT3" +
            "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
            "${params.coverage_bin_size ? '.' + params.coverage_bin_size : ''}" +
            ".${meta.norm_factor_type}" +
            "${meta.norm_factor_type == 'raw' ? '.map' : ''}" +
            "${meta.signal_over_input ? '.soi' : ''}" +
            ".sorted" 
        }
        ext.args  = "-k1,1 -k2,2n"
        publishDir = [
              path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}" +
                    "/coverage/" +
                    "${meta.norm_factor_type}" +
                    "${meta.signal_over_input ? '/cisrpm_soi' : ''}"
                },
            mode: params.publish_dir_mode,
            pattern: "*.bedgraph",
            enabled: params.save_coverage_intermeds,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }

        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_NORMALIZE_BIGWIG_DEEPTOOLS:UCSC_BEDGRAPHTOBIGWIG_(ENDO|EXO)' {
        ext.prefix = {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
            ".flT3" +
            "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
            "${params.coverage_bin_size ? '.' + params.coverage_bin_size : ''}" +
            ".${meta.norm_factor_type}" +
            "${meta.norm_factor_type == 'raw' ? '.map' : ''}" +
            "${meta.signal_over_input ? '.soi' : ''}"
        }
        publishDir = [
            path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}" +
                    "/coverage/" +
                    "${meta.norm_factor_type}" +
                    "${meta.signal_over_input ? '/cisrpm_soi' : ''}"
                },
            mode: params.publish_dir_mode,
            pattern: "*.bigWig",
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    if (params.coverage_bin_size != 1 && !params.skip_plot_profile) {
        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_NORMALIZE_BIGWIG_DEEPTOOLS:DEEPTOOLS_BAMCOVERAGE_BINSIZE1' {
            ext.prefix = {
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".mLb." +
                "${params.with_umi ? 'dedup' : 'mkD'}" +
                ".flT1" +
                "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                ".flT3" +
                "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                ".1" +
                ".${meta.norm_factor_type}"
            }
            // TODO: the blacklist should be inputted to the process directly, which is not possible in the current nf-core implementation
            // params.blacklist ? "--blackListFileName ${params.blacklist}" : "",
            ext.args = { [
                params.coverage_extend_reads ? "--extendReads ${params.coverage_extend_reads}" : "",
                "--binSize 1" ,
                "--scaleFactor ${meta.norm_factor_val}",
                "--outFileFormat bigwig"
            ].join(' ').trim() }
            publishDir = [
                path: { 
                        "${params.outdir}/${params.aligner}/mergedLibrary/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                        "/${meta.exp_type}" +
                        "/coverage/" +
                        "${meta.norm_factor_type}"
                    },
                mode: params.publish_dir_mode,
                pattern: "*.bigWig",
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}

if (!params.skip_plot_profile) {
    process {
        withName: 'DEEPTOOLS_COMPUTEMATRIX' {
            ext.args   = 'scale-regions --regionBodyLength 1000 --beforeRegionStartLength 3000 --afterRegionStartLength 3000 --missingDataAsZero --skipZeros --smartLabels'
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/plotProfile" 
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'DEEPTOOLS_PLOTPROFILE' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/plotProfile" 
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'DEEPTOOLS_PLOTHEATMAP' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}" }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/plotProfile" 
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}

if (params.bam_downsampling_method) {
    process {
        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_DOWNSAMPLE:PICARD_DOWNSAMPLESAM' {
            ext.prefix = {
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".mLb." +
                "${params.with_umi ? 'dedup' : 'mkD'}" +
                ".flT1" +
                "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                ".flT3" +
                "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                ".dSp" +
                ".sorted"
            }
            ext.args   = { [
                "--PROBABILITY ${meta.downsampleA_prob}",
                "--STRATEGY ${params.bam_downsampling_strategy}",
                "--ACCURACY ${params.bam_downsampling_accuracy}",
                "--VALIDATION_STRINGENCY LENIENT",
                "--TMP_DIR tmp"
            ].join(' ').trim() }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/downsampled" 
                },
                mode: params.publish_dir_mode,
                pattern: "*.bam",
                enabled: params.save_downsampling_intermeds,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_DOWNSAMPLE:SAMTOOLS_INDEX' {
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/downsampled" 
                },
                mode: params.publish_dir_mode,
                pattern: '*.{bai,csi,crai}',
                enabled: params.save_downsampling_intermeds,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_DOWNSAMPLE:BAM_STATS_SAMTOOLS:.*' {
            ext.prefix = {
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".mLb." +
                "${params.with_umi ? 'dedup' : 'mkD'}" +
                ".flT1" +
                "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                ".flT3" +
                "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                ".dSp" +
                ".sorted"
            }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/downsampled" 
                },
                mode: params.publish_dir_mode,
                pattern: "*.{stats,flagstat,idxstats}",
                enabled: params.save_downsampling_intermeds,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}

if (!params.skip_consenrich) {
    process {
         withName: 'CONSENRICH' {
            ext.prefix = {
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".mLb." +
                "${params.with_umi ? 'dedup' : 'mkD'}" +
                ".flT1" +
                "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                ".flT3" +
                "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                "${params.bam_downsampling_method ? '.dSp' : '' }"
            }
            ext.args   = { [
                "--signal_bigwig ${task.ext.prefix}.consenrich_signal_track.bw",
                "--residual_bigwig ${task.ext.prefix}.consenrich_residuals_track.bw",
                "--eratio_bigwig ${task.ext.prefix}.consenrich_eratio_track.bw"
            ].join(' ').trim() }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/consenrich/"
                },
                mode: params.publish_dir_mode,
                pattern: '*.{tsv,tsv.gz,bw,json,npz}',
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}

if (!params.skip_plot_fingerprint) {
    process {
        withName: 'DEEPTOOLS_PLOTFINGERPRINT' {
            ext.prefix = {
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".mLb." +
                "${params.with_umi ? 'dedup' : 'mkD'}" +
                ".flT1" +
                "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                ".flT3" +
                "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                "${params.bam_downsampling_method ? '.dSp' : '' }"
            }
            ext.args   = { [
                '--skipZeros',
                "--numberOfSamples $params.fingerprint_bins",
                "--labels $meta.id $meta.control"
            ].join(' ').trim() }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/plotFingerprint" 
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}

process {
    if (!params.skip_edd) {
        withName: 'EDD' {
            // TODO: this errorStrategy is to skip when the bin size cannot be estimated (when it is not specified)
            errorStrategy = { task.exitStatus == 1 ? 'ignore' : 'terminate' }
            ext.prefix = {
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".mLb." +
                "${params.with_umi ? 'dedup' : 'mkD'}" +
                ".flT1" +
                "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                ".flT3" +
                "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                "${params.bam_downsampling_method ? '.dSp' : '' }"
            }
            ext.args  = { [
                params.edd_bin_size ? "--bin-size ${params.edd_bin_size}" : "",
                params.edd_gap_penalty ? "--gap-penalty ${params.edd_gap_penalty}" : "",
                "--num-trials ${params.edd_num_trials}",
                "--fdr ${params.edd_fdr}",
                "--write-log-ratios",
                "--write-bin-scores"
            ].join(' ').trim() }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/edd/"
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }

    withName: 'MACS3_CALLPEAK' {
        // TODO: this is only temporary to avoid "not enough peaks" error for samples with low read counts
        // try using workflow.failOnIgnore https://nextflow.io/docs/latest/reference/stdlib.html
        errorStrategy = { task.exitStatus == 1 ? 'ignore' : 'terminate' } 
        ext.prefix = {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
            ".flT3" +
            "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
            "${params.bam_downsampling_method ? '.dSp' : '' }"
        }
        ext.args   = {
            [
            '--keep-dup all',
            "--slocal ${params.macs_slocal}",
            meta.exp_type == 'atacseq'  ? "--nomodel --extsize ${params.macs_extsize}" : '',
            params.peak_cutoff_method == 'pvalue' ? "--pvalue ${params.narrow_cutoff}" : "--qvalue ${params.narrow_cutoff}",
            !params.narrow_peak ? "--broad --broad-cutoff ${params.broad_cutoff}" : '',
            params.save_macs_pileup     ? '--bdg --SPMR' : '',
            params.aligner == "chromap" ? "--format BAM" : ''
            ].join(' ').trim()
        }
        publishDir = [
            path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" 
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> 
                if (filename.equals('versions.yml')) {
                    return null
                } else {
                    // This replaces MACS3's suffixes of the form "*_control_lambda.bdg" with "*.control_lambda.bdg"
                    // TODO: instead of replacing this whole thing, we could use ext.prefix again?
                    def newFilename = filename.replaceFirst("^${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }_", "")
                    return "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }.${newFilename}"
                }
            }
        ]
    }

    if (params.save_macs_pileup) {
        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER:MACS3_BDGCMP' {
            ext.prefix = {
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".mLb." +
                "${params.with_umi ? 'dedup' : 'mkD'}" +
                ".flT1" +
                "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                ".flT3" +
                "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                "${params.bam_downsampling_method ? '.dSp' : '' }" +
                ".bdgcmp"
            }
            ext.args   = '--method FE'
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/bdgcmp"
                },
                mode: params.publish_dir_mode,
                pattern: "*.bedGraph",         
                enabled: params.save_macs_pileup_intermeds,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER:BEDTOOLS_SLOP' {
            ext.prefix = {
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".mLb." +
                "${params.with_umi ? 'dedup' : 'mkD'}" +
                ".flT1" +
                "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                ".flT3" +
                "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                "${params.bam_downsampling_method ? '.dSp' : '' }" +
                ".bdgcmp" +
                ".slop"
            }
            ext.args   = "-b 0"
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/bdgcmp"
                },
                mode: params.publish_dir_mode,
                pattern: "*.bed",
                enabled: params.save_macs_pileup_intermeds
            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER:AWK_FIX_MACS3_BDGCMP' {
            ext.prefix = {
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".mLb." +
                "${params.with_umi ? 'dedup' : 'mkD'}" +
                ".flT1" +
                "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                ".flT3" +
                "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                "${params.bam_downsampling_method ? '.dSp' : '' }" +
                ".bdgcmp" +
                ".awk"
            }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/bdgcmp"
                },
                mode: params.publish_dir_mode,
                pattern: "*.bed",
                enabled: params.save_macs_pileup_intermeds
            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER:UCSC_BEDCLIP' {
            ext.prefix = {
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".mLb." +
                "${params.with_umi ? 'dedup' : 'mkD'}" +
                ".flT1" +
                "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                ".flT3" +
                "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                "${params.bam_downsampling_method ? '.dSp' : '' }" +
                ".bdgcmp" +
                ".clip"
            }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/bdgcmp"
                },
                mode: params.publish_dir_mode,
                pattern: "*.bedGraph",
                enabled: params.save_macs_pileup_intermeds
            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER:FILE_SORT' {
            ext.prefix = {
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".mLb." +
                "${params.with_umi ? 'dedup' : 'mkD'}" +
                ".flT1" +
                "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                ".flT3" +
                "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                "${params.bam_downsampling_method ? '.dSp' : '' }" +
                ".bdgcmp"
            }
            ext.args  = "-k1,1 -k2,2n"
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/bdgcmp"
                },
                mode: params.publish_dir_mode,
                pattern: "*.sorted",
                enabled: params.save_macs_pileup_intermeds
            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER:UCSC_BEDGRAPHTOBIGWIG' {
            ext.prefix = {
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".mLb." +
                "${params.with_umi ? 'dedup' : 'mkD'}" +
                ".flT1" +
                "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                ".flT3" +
                "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                "${params.bam_downsampling_method ? '.dSp' : '' }" +
                ".bdgcmp" +
                ".fc.signal"
            }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/bdgcmp"
                },
                mode: params.publish_dir_mode,
                pattern: "*.bigWig"
            ]
        }
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER:FRIP_SCORE' {
        ext.args   = '-bed -c -f 0.20'
        ext.prefix = {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
            ".flT3" +
            "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
            "${params.bam_downsampling_method ? '.dSp' : '' }" +
            ".frip"
        }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/${meta.exp_type}/macs3/" +
                "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                "/qc"
            },
            enabled: false
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_PEAKS_CALL_QC_ANNOTATE_MACS3_HOMER:MULTIQC_CUSTOM_PEAKS' {
        ext.prefix = {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +
            "${params.with_umi ? 'dedup' : 'mkD'}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
            ".flT3" +
            "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
            "${params.bam_downsampling_method ? '.dSp' : '' }" +
            ".peaks"
        }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +

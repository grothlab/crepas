            "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
            ".flT3" +
            "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
            "${params.bam_downsampling_method ? '.dSp' : '' }" +
            ".genrich" +
            ".frip"
        }
        ext.args   = '-bed -c -f 0.20'
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/${meta.exp_type}/genrich/" +
                "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +

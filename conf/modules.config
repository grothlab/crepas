            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_SPIKEIN_SPLIT:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_INDEX' {
            publishDir = [
                path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split/flT2" },
                mode: params.publish_dir_mode,
                pattern: '*.{bai,csi,crai}'
            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_SPIKEIN_SPLIT:BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:.*' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1.${meta.genome}.flT2.sorted" }
            publishDir = [
                path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split/flT2" },
                mode: params.publish_dir_mode,
                pattern: "*.{stats,flagstat,idxstats}"
            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_FLAGSTAT_MAPPED_FLT2' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.allocate_n_multimappers && params.allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1.${meta.genome}.flT2.total_reads" }
            publishDir = [
                path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split/flT2" },
                mode: params.publish_dir_mode,
                pattern: "*.txt",
                enabled: false,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

    }
}

if (params.allocate_n_multimappers && params.allocation_method != 'chromap') {

    process {
        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_ALLOCATE_MULTIMAPPERS_(ENDO|EXO):SAMTOOLS_SORT' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}.nsorted" }
            ext.args   = '-n'
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/bam_nsorted/" },
                mode: params.publish_dir_mode,
                pattern: '*.bam',
                enabled: params.save_allocation_intermeds
            ]
        }

        if (params.allocation_method == 'allo') {
            withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_ALLOCATE_MULTIMAPPERS_(ENDO|EXO):ALLO' {
                ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}.allo" }
                //--ignore is used here to skip check for samtools collate in the bam header; samtools sort is used instead, but not detected
                ext.args =  { 
                    [
                        "--ignore",
                        params.allo_mixed_cnn ? '--mixed' : ''
                    ].join(' ').trim()
                }
                publishDir = [
                    [
                        path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.allocation_method}/" },
                        mode: params.publish_dir_mode,
                        pattern: "*.bam",
                        enabled: params.save_allocation_intermeds
                    ],
                    [
                        path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.allocation_method}/" },
                        mode: params.publish_dir_mode,
                        pattern: "*.log"    
                    ]
                ]
            }
        }

        if (params.allocation_method == 'mmr') {
            withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_ALLOCATE_MULTIMAPPERS_(ENDO|EXO):MMR' {
                ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}.mmr" }
                ext.args   = {
                [
                    "--best-only",
                    "--filter-dist 0",
                    "--init-secondary"
                ].join(' ').trim()
            }
                publishDir = [
                    path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.allocation_method}/" },
                    mode: params.publish_dir_mode,
                    pattern: "*.bam",
                    enabled: params.save_allocation_intermeds
                ]
            }
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_ALLOCATE_MULTIMAPPERS_(ENDO|EXO):BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}.${params.allocation_method}.sorted" }
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.allocation_method}/" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_allocation_intermeds,
                pattern: '*.bam'

            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_ALLOCATE_MULTIMAPPERS_(ENDO|EXO):BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_INDEX' {
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.allocation_method}/" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_allocation_intermeds
            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_ALLOCATE_MULTIMAPPERS_(ENDO|EXO):BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:SAMTOOLS_.*' {
            ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}.${params.allocation_method}.sorted" }
            publishDir = [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.allocation_method}/" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
                enabled: params.save_allocation_intermeds
            ]
        }
    
    }
}

process {
    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_SHIFT_READS:DEEPTOOLS_ALIGNMENTSIEVE' {
        ext.prefix = {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            ".mLb." +

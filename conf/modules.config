if (!params.skip_consensus_peaks) {
    process {
        withName: 'MACS3_CONSENSUS' {
            ext.when   = { meta.multiple_groups || meta.replicates_exist }
            ext.prefix = {
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".mLb." +
                "${params.with_umi ? 'dedup' : 'mkD'}" +
                ".flT1" +
                "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                ".flT3" +
                "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                "${params.bam_downsampling_method ? '.dSp' : '' }" +
                ".consensus_peaks"
            }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/consensus/${meta.id}"
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }

        withName: 'SUBREAD_FEATURECOUNTS'  {
            ext.args   = '-F SAF -O --fracOverlap 0.2'
            ext.prefix = {
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".mLb." +
                "${params.with_umi ? 'dedup' : 'mkD'}" +
                ".flT1" +
                "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                ".flT3" +
                "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                "${params.bam_downsampling_method ? '.dSp' : '' }" +
                ".consensus_peaks"
            }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/macs3/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                    "/consensus/${meta.id}"
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }

    if (!params.skip_peak_annotation) {
        process {
            withName: 'GROTHLAB_GLSEQ:GLSEQ:BED_CONSENSUS_QUANTIFY_QC_BEDTOOLS_FEATURECOUNTS_DESEQ2:HOMER_ANNOTATEPEAKS' {
                ext.args   = '-gid'
                ext.prefix = {
                    "${meta.id}" +
                    "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                    "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                    ".mLb." +
                    "${params.with_umi ? 'dedup' : 'mkD'}" +
                    ".flT1" +
                    "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                    "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                    ".flT3" +
                    "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                    "${params.bam_downsampling_method ? '.dSp' : '' }" +
                    ".consensus_peaks"
                }
                publishDir = [
                    path: { 
                        "${params.outdir}/${params.aligner}/mergedLibrary/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                        "/${meta.exp_type}/macs3/" +
                        "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                        "/consensus/${meta.id}"
                    },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
            }

            withName: 'ANNOTATE_BOOLEAN_PEAKS' {
                ext.prefix = {
                    "${meta.id}" +
                    "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                    "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                    ".mLb." +
                    "${params.with_umi ? 'dedup' : 'mkD'}" +
                    ".flT1" +
                    "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                    "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                    ".flT3" +
                    "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                    "${params.bam_downsampling_method ? '.dSp' : '' }" +
                    ".consensus_peaks"
                }
                publishDir = [
                    path: { 
                        "${params.outdir}/${params.aligner}/mergedLibrary/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                        "/${meta.exp_type}/macs3/" +
                        "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                        "/consensus/${meta.id}"
                    },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
            }
        }
    }

    if (!params.skip_deseq2_qc) {
        process {
            withName: 'DESEQ2_QC' {
                ext.when   = { meta.multiple_groups && meta.replicates_exist }
                ext.prefix = {
                    "${meta.id}" +
                    "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                    "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                    ".mLb." +
                    "${params.with_umi ? 'dedup' : 'mkD'}" +
                    ".flT1" +
                    "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                    "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                    ".flT3" +
                    "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                    "${params.bam_downsampling_method ? '.dSp' : '' }" +
                    ".consensus_peaks"
                }
                ext.args   = [
                    '--id_col 1',
                    '--sample_suffix \'.mLb.clN.sorted.bam\'', // TODO: this is not correct, the following is:
                    '--count_col 7',
                    params.deseq2_vst ? '--vst TRUE' : ''
                ].join(' ').trim()
                publishDir = [
                    path: { 
                        "${params.outdir}/${params.aligner}/mergedLibrary/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                        "/${meta.exp_type}/macs3/" +
                        "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" +
                        "/consensus/${meta.id}/deseq2"
                    },
                    mode: params.publish_dir_mode,
                    saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
                ]
            }
        }
    }
}

if (!params.skip_genrich) {
    process {

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_PEAKS_CALL_QC_ANNOTATE_GENRICH_HOMER:SAMTOOLS_SORT' {
            ext.prefix = {
                    "${meta.id}" +
                    "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                    "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                    ".mLb." +
                    "${params.with_umi ? 'dedup' : 'mkD'}" +
                    ".flT1" +
                    "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                    "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                    ".flT3" +
                    "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                    "${params.bam_downsampling_method ? '.dSp' : '' }" +
                    ".nsorted"
            }
            ext.args   = '-n'
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/genrich/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}" 
                },
                mode: params.publish_dir_mode,
                pattern: '*.bam',
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }

            ]
        }

        withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_PEAKS_CALL_QC_ANNOTATE_GENRICH_HOMER:GENRICH' {
            ext.prefix = {
                "${meta.id}" +
                "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
                "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
                ".mLb." +
                "${params.with_umi ? 'dedup' : 'mkD'}" +
                ".flT1" +
                "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
                "${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}" +
                ".flT3" +
                "${meta.exp_type == 'atacseq' ? '.shifted' : ''}" +
                "${params.bam_downsampling_method ? '.dSp' : '' }" +
                ".genrich"
            } 
            ext.args   = { [
                meta.exp_type == 'atacseq' ? '-j' : '',
                "-${params.peak_cutoff_method == 'pvalue' ? 'p' : 'q'} ${params.narrow_peak ? params.narrow_cutoff : params.broad_cutoff}",
                "-g ${params.narrow_peak ? params.genrich_narrow_gap : params.genrich_broad_gap}",
                params.save_genrich_pileup ? "-k ${task.ext.prefix}.pileup.bedGraph" : '',
                params.save_genrich_pvalues ? "-p ${task.ext.prefix}.pvalues.bedGraph" : '',
                params.save_genrich_intervals ? "-i ${task.ext.prefix}.intervals.bed" : ''
            ].join(' ').trim() }
            publishDir = [
                path: { 
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                    "/${meta.exp_type}/genrich/" +
                    "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}"
                },
                mode: params.publish_dir_mode,
                saveAs: { filename -> 
                    if (filename.equals('versions.yml')) {
                        return null
                    } else {
                        params.narrow_peak ? filename : filename.replaceFirst("\\.narrowPeak\$", ".broadPeak")
                    }
                }
            ]
        }
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_PEAKS_CALL_QC_ANNOTATE_GENRICH_HOMER:FRIP_SCORE' {
        ext.prefix = {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +

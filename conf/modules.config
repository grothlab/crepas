process {
    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:BAM_SPLIT_BY_STRAND' {
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/split/bam"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            pattern: "*.bam",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:BEDTOOLS_GENOMECOV' {
        ext.prefix = { meta.strand ? "${meta.id}.${meta.strand}" : "${meta.id}" }
        ext.args   = { [
            '-bg',
            meta.single_end && params.fragment_size > 0 ? "-fs ${params.fragment_size}" : '',
            !meta.single_end ? "-pc" : "",
            "-g $sizes"
        ].join(' ').trim() }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/split/bdg"
            },
            mode: params.publish_dir_mode,
            pattern: "*.bdg",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:BEDTOOLS_SLOP' {
        ext.prefix = { meta.strand ? "${meta.id}.${meta.strand}.slop" : "${meta.id}.slop" }
        ext.args   = "-b ${params.scar_slop}"
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/split/slop"
            },
            mode: params.publish_dir_mode,
            pattern: "*.bed",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:UCSC_BEDCLIP' {
        ext.prefix = { meta.strand ? "${meta.id}.${meta.strand}.clip" : "${meta.id}.clip" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/split/clip"
            },
            mode: params.publish_dir_mode,
            pattern: "*.bedGraph",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:FILE_SORT_WINDOWS' {
        ext.prefix = { meta.strand ? "${meta.id}.${meta.strand}.clip" : "${meta.id}.clip" }
        ext.args  = "-k1,1 -k2,2n"
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/split/sorted"
            },
            mode: params.publish_dir_mode,
            pattern: "*.sorted",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:UCSC_BEDGRAPHTOBIGWIG_WINDOWS' {
        ext.prefix = { meta.strand ? "${meta.id}.${meta.strand}" : "${meta.id}" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/split/bigwig"
            },
            mode: params.publish_dir_mode,
            pattern: "*.bigWig"
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:BEDTOOLS_MAKEWINDOWS' {
        ext.args   = { [
            "-i srcwinnum",
            "-w ${params.scar_window_size}",
            "-s ${params.scar_step_size}"
        ].join(' ').trim() }
        ext.prefix = { "${meta.id}.windows" }
        publishDir = [
            path: { "${params.outdir}/genome/windows" },
            mode: params.publish_dir_mode,
            pattern: "*.bed",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:BED_SPLIT_BY_CHROMOSOME' {
        ext.prefix = { "${meta.id}.chrsplit" }
        publishDir = [
            path: { "${params.outdir}/genome/windows" },
            mode: params.publish_dir_mode,
            pattern: "*.bed",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:UCSC_BIGWIGAVERAGEOVERBED' {
        ext.prefix = { "${meta.id}.${meta.chr}.${meta.strand}.bwaob" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/bwaob"
            },
            mode: params.publish_dir_mode,
            pattern: "*.tab",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:CPM_CALCULATION_.*' {
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/cpm"
            },
            mode: params.publish_dir_mode,
            pattern: "*.cpm",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:NORMALIZE_STRANDS' {
        ext.prefix = { "${meta.id}.${meta.chr}.${meta.strand}" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/norm"
            },
            mode: params.publish_dir_mode,
            pattern: "*.tab",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:SUBSTRACT_INPUT' {
        ext.prefix = { "${meta.id}.${meta.chr}.${meta.strand}.norm" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/minusinput"
            },
            mode: params.publish_dir_mode,
            pattern: "*.tab",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:PARTITION_SMOOTH' {
        ext.prefix = { "${meta.id}.${meta.chr}${meta.minusinput ? '.minusinput' : ''}" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/smooth"
            },
            mode: params.publish_dir_mode,
            pattern: "*.txt",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:COLLECT_PARTITIONS_BY_CHROMOSOME' {
        ext.prefix = { "${meta.id}.${meta.chr}${meta.minusinput ? '.minusinput' : ''}.smooth_results.w${params.scar_window_size}.s${params.scar_radius}.d${params.scar_dradius}.z${params.scar_zradius}" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/part_by_chr"
            },
            mode: params.publish_dir_mode,
            pattern: "*.txt",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:FINAL_PARTITION_BEDGRAPH' {
        ext.prefix = { "${meta.id}${meta.minusinput ? '.minusinput' : ''}.smooth_results.w${params.scar_window_size}.s${params.scar_radius}.d${params.scar_dradius}.z${params.scar_zradius}" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/final_smooth"
            },
            mode: params.publish_dir_mode,
            pattern: "*.{txt,tmp}",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:FILE_SORT_PARTITIONS' {
        ext.prefix = { "${meta.id}${meta.minusinput ? '.minusinput' : ''}.smooth_results.w${params.scar_window_size}.s${params.scar_radius}.d${params.scar_dradius}.z${params.scar_zradius}" }
        ext.args  = "-k1,1 -k2,2n"
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/final_smooth"
            },
            mode: params.publish_dir_mode,
            pattern: "*.bdg",
            enabled: params.save_scarseq_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:UCSC_BEDGRAPHTOBIGWIG_PARTITIONS' {
        ext.prefix = { "${meta.id}${meta.minusinput ? '.minusinput' : ''}.smooth_results.w${params.scar_window_size}.s${params.scar_radius}.d${params.scar_dradius}.z${params.scar_zradius}" }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/final_smooth"
            },
            mode: params.publish_dir_mode,
            pattern: "*.bigWig"
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_CREATE_SCAR_PARTITIONS:FINAL_PARTITION_PLOT' {
        ext.prefix = { "${meta.id}.smooth_results.w${params.scar_window_size}.s${params.scar_radius}.d${params.scar_dradius}.z${params.scar_zradius}" }
        ext.args   = { [
            "--cpm_cutoff ${params.scar_cpm_cutoff}",
            "--plot_range ${params.scar_plot_range}",
            params.scar_exclude_chromosomes ? "--exclude_chromosomes '${params.scar_exclude_chromosomes}'" : ''
        ].join(' ').trim() }
        publishDir = [
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/scarseq/final_smooth/plots"
            },
            mode: params.publish_dir_mode,
            pattern: "*.pdf"
        ]
    }
}

process {
    withName: 'GROTHLAB_GLSEQ:GLSEQ:SAMTOOLS_STATS_SUMMARY:SAMTOOLS_STATS_TRANSPOSE' {
        publishDir = [ 
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/samtools_stats_summary/transposed"
            },
            mode: params.publish_dir_mode,
            pattern: "*.tsv",
            enabled: false
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:SAMTOOLS_STATS_SUMMARY:SAMTOOLS_STATS_CAT' {
        ext.prefix = { "samtools_stats_summary${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }" }
        publishDir = [ 
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/samtools_stats_summary/"
            },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:SAMTOOLS_STATS_SUMMARY:FINAL_STAT_SUMMARY' {
        ext.prefix = { "final_samtools_stats_summary${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.flT2' : ''}${params.allocate_n_multimappers ? '.' + params.allocation_method : ''}.flT3${meta.exp_type == 'atacseq' ? '.shifted' : ''}${params.bam_downsampling_method ? '.dSp' : '' }" }
        publishDir = [ 
            path: { 
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}" +
                "/samtools_stats_summary/"
            },
            mode: params.publish_dir_mode,
            pattern: "*.tsv"
        ]
    }
}

if (!params.skip_igv) {
    process {
        withName: 'IGV' {
            publishDir = [
                [
                    path: { 
                        "${params.outdir}/igv/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}/" +
                        "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}"
                    },
                    mode: params.publish_dir_mode,
                    pattern: '*.{txt,xml}'
                ],
                [
                    path: { "${params.outdir}/genome" },
                    mode: params.publish_dir_mode,
                    pattern: '*.{fa,fasta}'
                ]
            ]
        }
    }
}

if (!params.skip_multiqc) {
    process {
        withName: 'MULTIQC' {
            ext.args   = params.multiqc_title ? "--title \"$params.multiqc_title\"" : ''
            publishDir = [
                path: { 
                        "${params.outdir}/multiqc/" +
                        "${params.allocate_n_multimappers ? params.allocation_method == 'chromap' ? 'cm_allo' : params.allocation_method : ''}/" +
                        "${params.narrow_peak ? 'narrow_peak' : 'broad_peak'}"
                    },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ]
        }
    }
}

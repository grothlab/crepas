nextflow_process {

    name "Test Process DANPOS2_DPOS"
    script "../main.nf"
    process "DANPOS2_DPOS"

    tag "modules"
    tag "modules_local"
    tag "danpos2"
    tag "danpos2/dpos"

    test("sarscov2 - bam - dpos - no background") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true) ], // treatment
                    [], // treatment_input
                    [], // treatment_count
                    [], // control
                    [], // control_input
                    []  // control_count
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.pooled_treat_wig,
                    process.out.pooled_smooth_positions,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - bam - dpos - with background") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true) ], // treatment
                    [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true) ], // treatment_input
                    [], // treatment_count
                    [], // control
                    [], // control_input
                    []  // control_count
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.pooled_treat_wig,
                    process.out.pooled_smooth_positions,
                    process.out.pooled_input_wig,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - bam - dpos - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true) ], // treatment
                    [], // treatment_input
                    [], // treatment_count
                    [], // control
                    [], // control_input
                    []  // control_count
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

nextflow_process {

    name "Test Process LANCEOTRON_CALLPEAKS"
    script "../main.nf"
    process "LANCEOTRON_CALLPEAKS"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "lanceotron"
    tag "lanceotron/callpeaks"
    tag "deeptools/bamcoverage"

    setup {
        run("DEEPTOOLS_BAMCOVERAGE", alias: "BAMCOVERAGE_IP") {
            script "../../../../nf-core/deeptools/bamcoverage/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test_ip', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ]
                input[1] = []
                input[2] = []
                input[3] = [ [:], [] ]
                """
            }
        }
    }

    test("homo_sapiens - bigwig") {

        when {
            process {
                """
                input[0] = BAMCOVERAGE_IP.out.bigwig
                    .map { meta, bw -> [ [ id:'test' ], bw ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("homo_sapiens - bigwig - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = BAMCOVERAGE_IP.out.bigwig
                    .map { meta, bw -> [ [ id:'test' ], bw ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

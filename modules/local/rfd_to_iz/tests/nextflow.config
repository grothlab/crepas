process {
    // 4-column windows (chrom, start, end, name) so COLLECT_PARTITIONS emits 12 columns.
    withName: 'BEDTOOLS_MAKEWINDOWS' {
        ext.args = '-w 1000 -i srcwinnum'
    }
    // Zero out column 4 of the RFD-slot table so RFD_deriv == 0 and covered bins pass the filter.
    withName: 'NORM_RFD' {
        ext.args2 = '--norm_factor 0'
    }
    // sarscov2 contig name (MT192765.1) contains a dot, so keep scaffolds; relax the
    // coverage/derivative cutoffs so the minimal test input still yields non-empty output.
    withName: 'RFD_TO_IZ' {
        ext.args = '--exclude_scaffolds FALSE --exclude_chromosomes none --rpm_cutoff 0 --zero_deriv_quantile 0'
    }
}

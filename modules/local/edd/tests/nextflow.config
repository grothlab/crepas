process {

    withName: EDD {
        // The pipeline ignores EDD failures (exit 1, no usable bin size); a test must not
        errorStrategy = 'terminate'
        // sarscov2 is far too small for EDD's default informative-bin requirements, so relax
        // them through the config-file options; log_ratio_bin_size shows up in the output name
        ext.args = [
            '--bin-size 2',
            '--num-trials 1000',
            '--max_CI_value 0.5',
            '--required_fraction_of_informative_bins 0.5',
            '--p_hat_CI_method wilson',
            '--log_ratio_bin_size 4',
            '--write-log-ratios',
            '--write-bin-scores',
        ].join(' ')
    }

}

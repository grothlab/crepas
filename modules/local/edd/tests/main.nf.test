nextflow_process {

    name "Test Process EDD"
    script "../main.nf"
    process "EDD"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "edd"

    test("sarscov2 - bam - domain calling") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'sarscov2' ], // meta2 map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.sizes', checkIfExists: true)
                ]
                input[2] = [
                    [ id:'blacklist' ], // meta3 map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test2.bed', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // the log holds a timestamp and the work directory, so only its name is snapshotted
                { assert snapshot(
                    process.out.peaks,
                    process.out.bin_score,
                    process.out.log_ratios,
                    process.out.log.collect { meta, log -> [ meta, file(log).name ] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() },
                // the config-file options from ext.args reach EDD
                { assert path(process.out.log[0][1]).text.contains('ci_method:wilson') }
            )
        }

    }

    test("sarscov2 - bam - domain calling - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'sarscov2' ], // meta2 map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.sizes', checkIfExists: true)
                ]
                input[2] = [
                    [ id:'blacklist' ], // meta3 map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test2.bed', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

nextflow_process {

    name "Test Process STATS_TRANSPOSE"
    script "../main.nf"
    process "STATS_TRANSPOSE"

    tag "modules"
    tag "modules_local"
    tag "stats_transpose"
    tag "samtools/stats"

    test("sarscov2 - stats - transpose") {

        setup {
            run("SAMTOOLS_STATS") {
                script "../../../nf-core/samtools/stats/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test.mLb.mkD.sorted', single_end:false ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                    ]
                    input[1] = [ [], [], [] ]
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SAMTOOLS_STATS.out.stats
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.t_stats,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - stats - transpose - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test.mLb.mkD.sorted', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

nextflow_process {

    name "Test Process MULTIQC_CUSTOM_PHANTOMPEAKQUALTOOLS"
    script "../main.nf"
    process "MULTIQC_CUSTOM_PHANTOMPEAKQUALTOOLS"

    tag "modules"
    tag "modules_local"
    tag "multiqc_custom_phantompeakqualtools"
    tag "phantompeakqualtools"

    setup {
        run("PHANTOMPEAKQUALTOOLS") {
            script "../../phantompeakqualtools/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.bam', checkIfExists: true),
                    []
                ]
                """
            }
        }
    }

    test("sarscov2 - phantompeakqualtools - multiqc custom content") {

        when {
            process {
                """
                input[0] = PHANTOMPEAKQUALTOOLS.out.ccscores.join(PHANTOMPEAKQUALTOOLS.out.rdata, by: 0)
                input[1] = file("${projectDir}/assets/multiqc/spp_nsc_header.txt", checkIfExists: true)
                input[2] = file("${projectDir}/assets/multiqc/spp_rsc_header.txt", checkIfExists: true)
                input[3] = file("${projectDir}/assets/multiqc/spp_correlation_header.txt", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.nsc,
                    process.out.rsc,
                    // cross-correlation table is generated by run_spp.R upstream; snapshot its
                    // shape (name + row count) rather than potentially-jittering numeric content
                    file(process.out.correlation.get(0).get(1)).name,
                    path(process.out.correlation.get(0).get(1)).readLines().size(),
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - phantompeakqualtools - multiqc custom content - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = PHANTOMPEAKQUALTOOLS.out.ccscores.join(PHANTOMPEAKQUALTOOLS.out.rdata, by: 0)
                input[1] = file("${projectDir}/assets/multiqc/spp_nsc_header.txt", checkIfExists: true)
                input[2] = file("${projectDir}/assets/multiqc/spp_rsc_header.txt", checkIfExists: true)
                input[3] = file("${projectDir}/assets/multiqc/spp_correlation_header.txt", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

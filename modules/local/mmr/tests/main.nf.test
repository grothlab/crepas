nextflow_process {

    name "Test Process MMR"
    script "../main.nf"
    process "MMR"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "mmr"
    tag "samtools/sort"

    test("sarscov2 - bam - paired_end") {

        setup {
            run("SAMTOOLS_SORT") {
                script "../../../nf-core/samtools/sort/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test', single_end:false ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                    ]
                    input[1] = [[ id:'test' ], [], []]
                    input[2] = []
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SAMTOOLS_SORT.out.bam
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.bam.collect { meta, b -> [ meta, [b].flatten().collect { file(it).name + ":readsMD5," + bam(it.toString()).getReadsMD5() } ] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - bam - single_end") {

        setup {
            run("SAMTOOLS_SORT") {
                script "../../../nf-core/samtools/sort/main.nf"
                process {
                    """
                    input[0] = [
                        [ id:'test_se', single_end:true ], // meta map
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.single_end.bam', checkIfExists: true)
                    ]
                    input[1] = [[ id:'test_se' ], [], []]
                    input[2] = []
                    """
                }
            }
        }

        when {
            process {
                """
                input[0] = SAMTOOLS_SORT.out.bam
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.bam.collect { meta, b -> [ meta, [b].flatten().collect { file(it).name + ":readsMD5," + bam(it.toString()).getReadsMD5() } ] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - bam - paired_end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

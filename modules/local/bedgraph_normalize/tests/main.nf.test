nextflow_process {

    name "Test Process BEDGRAPH_NORMALIZE"
    script "../main.nf"
    process "BEDGRAPH_NORMALIZE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "bedgraph_normalize"

    test("homo_sapiens - bedgraph - multiply with pseudocount") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bedgraph/cutandtag_h3k27me3_test_1.bedGraph', checkIfExists: true)
                ]
                input[1] = 'bedGraph'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.normalized,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("homo_sapiens - bedgraph - multiply with pseudocount - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bedgraph/cutandtag_h3k27me3_test_1.bedGraph', checkIfExists: true)
                ]
                input[1] = 'bedGraph'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

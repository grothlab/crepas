nextflow_process {

    name "Test Process PLOT_PEAK_QC"
    script "../main.nf"
    process "PLOT_PEAK_QC"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "plot_peak_qc"
    tag "macs3/callpeak"

    setup {

        run("MACS3_CALLPEAK", alias: "CALLPEAK_SAMPLE1") {
            script "../../../nf-core/macs3/callpeak/main.nf"
            process {
                """
                input[0] = [
                    [ id:'sample1', single_end:false ], // meta map
                    [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.name.sorted.bam', checkIfExists: true) ],
                    []
                ]
                input[1] = 40000
                """
            }
        }

        run("MACS3_CALLPEAK", alias: "CALLPEAK_SAMPLE2") {
            script "../../../nf-core/macs3/callpeak/main.nf"
            process {
                """
                input[0] = [
                    [ id:'sample2', single_end:false ], // meta map
                    [ file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bam/test.paired_end.name.sorted.bam', checkIfExists: true) ],
                    []
                ]
                input[1] = 40000
                """
            }
        }

    }

    test("homo_sapiens - 2 samples - score columns") {

        when {
            process {
                """
                input[0] = CALLPEAK_SAMPLE1.out.peak
                    .mix(CALLPEAK_SAMPLE2.out.peak)
                    .map { meta, peak -> [ [ id: 'test_group' ], peak ] }
                    .groupTuple()
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.txt[0][1]).name,
                    path(process.out.txt[0][1]).readLines().collect { it.split("\t")[-2] }.unique(),
                    file(process.out.pdf[0][1]).name,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("homo_sapiens - 2 samples - count and length only") {

        config "./nextflow.no_columns.config"

        when {
            process {
                """
                input[0] = CALLPEAK_SAMPLE1.out.peak
                    .mix(CALLPEAK_SAMPLE2.out.peak)
                    .map { meta, peak -> [ [ id: 'test_group' ], peak ] }
                    .groupTuple()
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.txt[0][1]).readLines().collect { it.split("\t")[-2] }.unique(),
                    file(process.out.pdf[0][1]).name
                    ).match() }
            )
        }

    }

    test("homo_sapiens - 2 samples - score columns - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = CALLPEAK_SAMPLE1.out.peak
                    .mix(CALLPEAK_SAMPLE2.out.peak)
                    .map { meta, peak -> [ [ id: 'test_group' ], peak ] }
                    .groupTuple()
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

nextflow_process {

    name "Test Process SPIKEIN_BARCODE_QC"
    script "../main.nf"
    process "SPIKEIN_BARCODE_QC"

    tag "modules"
    tag "modules_local"
    tag "spikein_barcode_qc"
    tag "fastq_extract_spikein_barcodes"

    setup {

        run("FASTQ_EXTRACT_SPIKEIN_BARCODES", alias: "EXTRACT_SAMPLE1") {
            script "../../fastq_extract_spikein_barcodes/main.nf"
            process {
                """
                input[0] = [
                    [ id:'sample1' ], // meta map
                    [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ]
                ]
                input[1] = [
                    [ id:'spikein_barcodes' ], // meta2 map
                    file('https://raw.githubusercontent.com/grothlab/crepas/6d7eb52e32f7e83e7e43664ae9ed955f51e68171/assets/barcodes/sc_spikein_barcodes.tsv', checkIfExists: true)
                ]
                """
            }
        }

        run("FASTQ_EXTRACT_SPIKEIN_BARCODES", alias: "EXTRACT_SAMPLE2") {
            script "../../fastq_extract_spikein_barcodes/main.nf"
            process {
                """
                input[0] = [
                    [ id:'sample2' ], // meta map
                    [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test2_1.fastq.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test2_2.fastq.gz', checkIfExists: true) ]
                ]
                input[1] = [
                    [ id:'spikein_barcodes' ], // meta2 map
                    file('https://raw.githubusercontent.com/grothlab/crepas/6d7eb52e32f7e83e7e43664ae9ed955f51e68171/assets/barcodes/sc_spikein_barcodes.tsv', checkIfExists: true)
                ]
                """
            }
        }

    }

    test("sarscov2 - 2 samples - qc long/summary tables and heatmap") {

        when {
            process {
                """
                input[0] = EXTRACT_SAMPLE1.out.counts
                    .mix(EXTRACT_SAMPLE2.out.counts)
                    .map { meta, counts -> [ [ id: 'test_group' ], counts ] }
                    .groupTuple()
                    .map { meta, counts -> [ meta, counts.sort { it.name } ] }
                    .map { meta, counts -> [ meta, counts, [ 1000000.0, 1200000.0 ] ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.long,
                    process.out.summary,
                    file(process.out.plot_pdf[0][1]).name,
                    file(process.out.plot_png[0][1]).name,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - 2 samples - qc long/summary tables and heatmap - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = EXTRACT_SAMPLE1.out.counts
                    .mix(EXTRACT_SAMPLE2.out.counts)
                    .map { meta, counts -> [ [ id: 'test_group' ], counts ] }
                    .groupTuple()
                    // .mix() interleaves EXTRACT_SAMPLE1/2 in whichever order they finish, so
                    // sort by filename for a deterministic row order in the module's long.tsv
                    // output (sample1... < sample2... alphabetically, matching uniq_totals below).
                    .map { meta, counts -> [ meta, counts.sort { it.name } ] }
                    .map { meta, counts -> [ meta, counts, [ 1000000.0, 1200000.0 ] ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

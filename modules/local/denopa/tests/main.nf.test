nextflow_process {

    name "Test Process DENOPA"
    script "../main.nf"
    process "DENOPA"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "denopa"
    tag "bowtie2/build"
    tag "bowtie2/align"
    tag "samtools/reheader"
    tag "samtools/view"
    tag "samtools/sort"
    tag "samtools/index"

    // denopa (deNOPA v1.0.3) has bugs: (1) its default --chromInclude regex only accepts
    // UCSC-style "chr*" names, so e.g. sarscov2's "MT192765.1" is silently excluded, leaving
    // zero chromosomes to process; (2) it pairs reads by name without checking if a "mate" is
    // unmapped, crashing on reference_end=None. Route around both here:
    // align one of nf-core/atacseq's own real S. cerevisiae ATAC-seq FASTQ pairs (real signal,
    // not module-test-scale), reheader "I" to "chr1", and pre-filter to properly-paired/
    // both-mapped reads with samtools view.
    setup {

        run("BOWTIE2_BUILD") {
            script "../../../nf-core/bowtie2/build/main.nf"
            process {
                """
                input[0] = [
                    [ id:'saccer' ], // meta map
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/atacseq/reference/genome.fa', checkIfExists: true)
                ]
                """
            }
        }

        run("BOWTIE2_ALIGN") {
            script "../../../nf-core/bowtie2/align/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false, exp_type:'ATAC-seq' ], // meta map
                    [
                        file('https://raw.githubusercontent.com/nf-core/test-datasets/atacseq/testdata/SRR1822153_1.fastq.gz', checkIfExists: true),
                        file('https://raw.githubusercontent.com/nf-core/test-datasets/atacseq/testdata/SRR1822153_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = BOWTIE2_BUILD.out.index
                input[2] = [ [:], [] ]
                input[3] = false
                input[4] = true
                """
            }
        }

        run("SAMTOOLS_REHEADER") {
            script "../../../nf-core/samtools/reheader/main.nf"
            process { "input[0] = BOWTIE2_ALIGN.out.bam.map { meta, bam -> [ meta, bam, [] ] }" }
        }

        run("SAMTOOLS_VIEW") {
            script "../../../nf-core/samtools/view/main.nf"
            process {
                """
                input[0] = SAMTOOLS_REHEADER.out.bam.map { meta, bam -> [ meta, bam, [] ] }
                input[1] = [ [:], [], [] ]
                input[2] = [ [:], [] ]
                input[3] = [ [:], [] ]
                input[4] = []
                """
            }
        }

        run("SAMTOOLS_SORT") {
            script "../../../nf-core/samtools/sort/main.nf"
            process {
                """
                input[0] = SAMTOOLS_VIEW.out.bam
                input[1] = [ [:], [], [] ]
                input[2] = []
                """
            }
        }

        run("SAMTOOLS_INDEX") {
            script "../../../nf-core/samtools/index/main.nf"
            process { "input[0] = SAMTOOLS_SORT.out.bam" }
        }

    }

    test("saccharomyces_cerevisiae - bam - atac-seq nucleosome calling") {

        when {
            process {
                """
                input[0] = SAMTOOLS_SORT.out.bam.join(SAMTOOLS_INDEX.out.index, by: 0)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.arers,
                    process.out.nfrs,
                    process.out.nucleosomes,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("saccharomyces_cerevisiae - bam - atac-seq nucleosome calling - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = SAMTOOLS_SORT.out.bam.join(SAMTOOLS_INDEX.out.index, by: 0)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

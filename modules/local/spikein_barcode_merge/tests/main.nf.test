nextflow_process {

    name "Test Process SPIKEIN_BARCODE_MERGE"
    script "../main.nf"
    process "SPIKEIN_BARCODE_MERGE"

    tag "modules"
    tag "modules_local"
    tag "spikein_barcode_merge"
    tag "fastq_extract_spikein_barcodes"

    setup {

        run("FASTQ_EXTRACT_SPIKEIN_BARCODES", alias: "EXTRACT_REP1") {
            script "../../fastq_extract_spikein_barcodes/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test_tRep_1' ], // meta map
                    [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true) ]
                ]
                input[1] = [
                    [ id:'spikein_barcodes' ], // meta2 map
                    file('https://raw.githubusercontent.com/grothlab/crepas/6d7eb52e32f7e83e7e43664ae9ed955f51e68171/assets/barcodes/sc_spikein_barcodes.tsv', checkIfExists: true)
                ]
                """
            }
        }

        run("FASTQ_EXTRACT_SPIKEIN_BARCODES", alias: "EXTRACT_REP2") {
            script "../../fastq_extract_spikein_barcodes/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test_tRep_2' ], // meta map
                    [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test2_1.fastq.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test2_2.fastq.gz', checkIfExists: true) ]
                ]
                input[1] = [
                    [ id:'spikein_barcodes' ], // meta2 map
                    file('https://raw.githubusercontent.com/grothlab/crepas/6d7eb52e32f7e83e7e43664ae9ed955f51e68171/assets/barcodes/sc_spikein_barcodes.tsv', checkIfExists: true)
                ]
                """
            }
        }

    }

    test("sarscov2 - 2 resequenced replicates - merge counts") {

        when {
            process {
                """
                input[0] = EXTRACT_REP1.out.counts
                    .mix(EXTRACT_REP2.out.counts)
                    .map { meta, counts -> [ [ id: 'test' ], counts ] }
                    .groupTuple()
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.merged_counts,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - 1 replicate - symlink counts through unchanged") {

        when {
            process {
                """
                input[0] = EXTRACT_REP1.out.counts
                    .map { meta, counts -> [ [ id: 'test' ], counts ] }
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.merged_counts,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - 2 resequenced replicates - merge counts - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = EXTRACT_REP1.out.counts
                    .mix(EXTRACT_REP2.out.counts)
                    .map { meta, counts -> [ [ id: 'test' ], counts ] }
                    .groupTuple()
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

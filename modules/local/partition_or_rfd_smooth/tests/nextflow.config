process {
    withName: 'BEDTOOLS_MAKEWINDOWS' {
        ext.args = '-w 1000 -i srcwinnum'
    }
    // Two normalizations of the same coverage table, with different operations, so the
    // forward/reverse values differ non-proportionally and the resulting partition score
    // varies across windows (and F+R stays > 0, avoiding the script's zero division).
    // Distinct prefixes keep the two output filenames from colliding downstream.
    withName: 'NORM_F' {
        ext.prefix = 'test_fwd'
        ext.args2  = '--norm_factor 1 --add_pseudocount'
    }
    withName: 'NORM_R' {
        ext.prefix = 'test_rev'
        ext.args2  = '--norm_operation add --norm_factor 5 --add_pseudocount'
    }
}

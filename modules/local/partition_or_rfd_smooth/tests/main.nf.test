nextflow_process {

    name "Test Process PARTITION_OR_RFD_SMOOTH"
    script "../main.nf"
    process "PARTITION_OR_RFD_SMOOTH"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "partition_or_rfd_smooth"
    tag "bedtools/makewindows"
    tag "ucsc/bigwigaverageoverbed"
    tag "bedgraph_normalize"
    tag "file_sort"

    setup {

        // Windows across the genome, named <chrom>_<window> (as the script expects).
        run("BEDTOOLS_MAKEWINDOWS") {
            script "../../../nf-core/bedtools/makewindows/main.nf"
            process {
                """
                input[0] = [ [ id:'test' ], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.sizes', checkIfExists: true) ]
                """
            }
        }

        // Average a real bigWig over those windows -> per-window coverage table.
        run("UCSC_BIGWIGAVERAGEOVERBED") {
            script "../../../nf-core/ucsc/bigwigaverageoverbed/main.nf"
            process {
                """
                input[0] = BEDTOOLS_MAKEWINDOWS.out.bed
                    .map { meta, bed -> [ meta, bed, file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bigwig/test.bigwig', checkIfExists: true) ] }
                """
            }
        }

        // Forward table: multiply (+ pseudocount) -> value = coverage + 1
        run("BEDGRAPH_NORMALIZE", alias: "NORM_F") {
            script "../../bedgraph_normalize/main.nf"
            process {
                """
                input[0] = UCSC_BIGWIGAVERAGEOVERBED.out.tab
                input[1] = 'tab'
                """
            }
        }

        // Reverse table: add (+ pseudocount) -> value = coverage + 6, so F != R non-proportionally
        run("BEDGRAPH_NORMALIZE", alias: "NORM_R") {
            script "../../bedgraph_normalize/main.nf"
            process {
                """
                input[0] = UCSC_BIGWIGAVERAGEOVERBED.out.tab
                input[1] = 'tab'
                """
            }
        }

        // The same tables sorted by window name, as BWAOB_SORT does in the pipeline (_1, _10, _11, ..., _2, ...)
        run("FILE_SORT", alias: "SORT_F") {
            script "../../file_sort/main.nf"
            process {
                """
                input[0] = NORM_F.out.normalized
                input[1] = 'tab'
                """
            }
        }

        run("FILE_SORT", alias: "SORT_R") {
            script "../../file_sort/main.nf"
            process {
                """
                input[0] = NORM_R.out.normalized
                input[1] = 'tab'
                """
            }
        }

    }

    test("sarscov2 - partition - smooth") {

        when {
            process {
                """
                input[0] = NORM_F.out.normalized
                    .join(NORM_R.out.normalized, by: 0)
                    .map { meta, f_tab, r_tab -> [ meta, 'partition', f_tab, r_tab ] }
                input[1] = 5  // radius
                input[2] = 5  // dradius
                input[3] = 1  // zradius
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.rfd,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - partition - smooth - input sorted by window name") {

        when {
            process {
                """
                input[0] = NORM_F.out.normalized
                    .join(NORM_R.out.normalized, by: 0)
                    .map { meta, f_tab, r_tab -> [ [ id:'genomic' ], 'partition', f_tab, r_tab ] }
                    .mix(SORT_F.out.sorted
                        .join(SORT_R.out.sorted, by: 0)
                        .map { meta, f_tab, r_tab -> [ [ id:'by_name' ], 'partition', f_tab, r_tab ] })
                input[1] = 5
                input[2] = 5
                input[3] = 1
                """
            }
        }

        then {
            def lines = process.out.rfd.collectEntries { meta, tsv -> [ meta.id, path(tsv).readLines() ] }
            def ids = { tsv_lines -> tsv_lines.collect { it.split('\t')[0] } }
            assertAll(
                { assert process.success },
                // one output line per input line, in the input order
                { assert ids(lines.by_name) == ids(lines.genomic).sort(false) },
                { assert ids(lines.by_name) != ids(lines.genomic) },
                // and the same values for every window, whatever the input order
                { assert lines.by_name.sort(false) == lines.genomic.sort(false) }
            )
        }

    }

    test("sarscov2 - partition - smooth - F and R in different orders") {

        when {
            process {
                """
                input[0] = NORM_F.out.normalized
                    .join(SORT_R.out.sorted, by: 0)
                    .map { meta, f_tab, r_tab -> [ meta, 'partition', f_tab, r_tab ] }
                input[1] = 5
                input[2] = 5
                input[3] = 1
                """
            }
        }

        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains('Both must list the same windows in the same order') }
            )
        }

    }

    test("sarscov2 - partition - smooth - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = NORM_F.out.normalized
                    .join(NORM_R.out.normalized, by: 0)
                    .map { meta, f_tab, r_tab -> [ meta, 'partition', f_tab, r_tab ] }
                input[1] = 5
                input[2] = 5
                input[3] = 1
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

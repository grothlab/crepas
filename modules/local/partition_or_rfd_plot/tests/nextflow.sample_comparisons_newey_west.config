process {
    withName: 'BEDTOOLS_MAKEWINDOWS' {
        ext.args = '-w 1000 -i srcwinnum'
    }
    withName: 'WINDOWS_SORT' {
        ext.prefix = 'windows.sorted'
        ext.args   = '-k4,4'
    }
    withName: 'BWAOB_SORT' {
        ext.prefix = { "${meta.id}.sorted" }
        ext.args   = '-k1,1'
    }
    withName: 'BWAOB_NORMALIZE' {
        ext.prefix = { "${meta.id}.norm" }
        ext.args2  = '--norm_factor 1 --add_pseudocount'
    }
    withName: 'RFD_TO_IZ' {
        ext.args = '--rpm_cutoff 0 --zero_deriv_quantile 0'
    }
    withName: 'PARTITION_OR_RFD_PLOT' {
        ext.args = '--rpm_cutoff 0 --rfd_names okseq_a,okseq_b --violin_test newey_west --newey_west_lag 2'
    }
}

process {
    withName: 'BEDTOOLS_MAKEWINDOWS' {
        ext.args = '-w 1000 -i srcwinnum'
    }
    withName: 'NORM_RFD' {
        ext.args2 = '--norm_factor 0'
    }
    // sarscov2 contig name (MT192765.1) has a dot -> keep scaffolds; relax cutoffs so the
    // minimal input yields non-empty initiation zones and non-empty plots.
    withName: 'RFD_TO_IZ' {
        ext.args = '--exclude_scaffolds FALSE --exclude_chromosomes none --rpm_cutoff 0 --zero_deriv_quantile 0'
    }
    withName: 'PARTITION_OR_RFD_PLOT' {
        ext.args = '--exclude_scaffolds FALSE --exclude_chromosomes none --rpm_cutoff 0'
    }
}

nextflow_process {

    name "Test Process FASTA_SPLIT_BY_GENOME"
    script "../main.nf"
    process "FASTA_SPLIT_BY_GENOME"

    tag "modules"
    tag "modules_local"
    tag "fasta_split_by_genome"
    tag "build_hybrid_fasta"

    setup {

        run("BUILD_HYBRID_FASTA") {
            script "../../build_hybrid_fasta/main.nf"
            process {
                """
                input[0] = [
                    [ id:'sarscov2' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    'sarscov2'
                ]
                input[1] = [
                    [ id:'homo_sapiens' ], // meta2 map
                    file(params.modules_testdata_base_path + 'genomics/homo_sapiens/genome/genome.fasta', checkIfExists: true),
                    'homo_sapiens'
                ]
                """
            }
        }

    }

    test("sarscov2 + homo_sapiens - split fasta by genome") {

        when {
            process {
                """
                input[0] = BUILD_HYBRID_FASTA.out.fasta
                input[1] = 'homo_sapiens'
                input[2] = 'sarscov2'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.endo_fasta,
                    process.out.exo_fasta,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 + homo_sapiens - split fasta by genome - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = BUILD_HYBRID_FASTA.out.fasta
                input[1] = 'homo_sapiens'
                input[2] = 'sarscov2'
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

nextflow_process {

    name "Test Process BIGTOOLS_BEDGRAPHTOBIGWIG"
    script "../main.nf"
    process "BIGTOOLS_BEDGRAPHTOBIGWIG"

    tag "modules"
    tag "modules_local"
    tag "bigtools"
    tag "bigtools/bedgraphtobigwig"

    test("sarscov2 - bedgraph") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bedgraph/test.bedgraph', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'genome' ], // meta2 map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.sizes', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.bigwig[0][1]).name,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - bedgraph - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bedgraph/test.bedgraph', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'genome' ], // meta2 map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.sizes', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

process {
    withName: 'BEDTOOLS_MAKEWINDOWS' {
        ext.args = '-w 1000 -i srcwinnum'
    }
    withName: 'WINDOWS_SORT' {
        ext.prefix = 'windows'
        ext.args   = '-k4,4'
    }
    withName: 'BWAOB_SORT_FWD' {
        ext.prefix = 'bwaob_fwd'
        ext.args   = '-k1,1'
    }
    withName: 'BWAOB_SORT_REV' {
        ext.prefix = 'bwaob_rev'
        ext.args   = '-k1,1'
    }
    withName: 'NORM_F' {
        ext.prefix = 'norm_fwd'
        ext.args2  = '--norm_factor 1 --add_pseudocount'
    }
    withName: 'NORM_R' {
        ext.prefix = 'norm_rev'
        ext.args2  = '--norm_operation add --norm_factor 5 --add_pseudocount'
    }
}

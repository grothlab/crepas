nextflow_process {

    name "Test Process DEEPTOOLS_BIGWIGAVERAGE"
    script "../main.nf"
    process "DEEPTOOLS_BIGWIGAVERAGE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "deeptools"
    tag "deeptools/bigwigaverage"

    test("homo_sapiens - 2 bigwig files - average") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bigwig/test_S2.RPKM.bw', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bigwig/test_S3.RPKM.bw', checkIfExists: true)
                    ]
                ]
                input[1] = [
                    [ id:'no_blacklist' ],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.bigwig.collect { entry -> [ entry[0], file(entry[1]).name ] },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("homo_sapiens - 1 bigwig file - symlinked") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bigwig/test_S2.RPKM.bw', checkIfExists: true)
                    ]
                ]
                input[1] = [
                    [ id:'no_blacklist' ],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.bigwig,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("homo_sapiens - 2 bigwig files - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bigwig/test_S2.RPKM.bw', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/homo_sapiens/illumina/bigwig/test_S3.RPKM.bw', checkIfExists: true)
                    ]
                ]
                input[1] = [
                    [ id:'no_blacklist' ],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

nextflow_process {

    name "Test Process DESEQ2_QC"
    script "../main.nf"
    process "DESEQ2_QC"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "deseq2_qc"
    tag "bowtie2/build"
    tag "bowtie2/align"
    tag "subread/featurecounts"

    // nf-core/test-datasets' generic per-module data (sarscov2 ~11 genes, homo_sapiens
    // chr21/22 module-test BAMs with only a handful of reads) are too sparse for DESeq2's
    // dispersion-curve fitting to succeed under any fitType. Use nf-core/chipseq's own real
    // (ss100k-subsampled) S. cerevisiae ChIP-seq FASTQs against its small single-chromosome
    // reference (51 annotated genes) instead: two genuinely different real samples (a ChIP
    // input and a T0 timepoint), aligned for real with bowtie2.
    setup {

        run("BOWTIE2_BUILD") {
            script "../../../nf-core/bowtie2/build/main.nf"
            process {
                """
                input[0] = [
                    [ id:'saccer' ], // meta map
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/626c8fab639062eade4b10747e919341cbf9b41a/reference/genome.fasta', checkIfExists: true)
                ]
                """
            }
        }

        run("BOWTIE2_ALIGN", alias: "ALIGN_T0") {
            script "../../../nf-core/bowtie2/align/main.nf"
            process {
                """
                input[0] = [
                    [ id:'spt5_t0', single_end:false ], // meta map
                    [
                        file('https://raw.githubusercontent.com/nf-core/test-datasets/atacseq/testdata/SRR1822153_1.fastq.gz', checkIfExists: true),
                        file('https://raw.githubusercontent.com/nf-core/test-datasets/atacseq/testdata/SRR1822153_2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = BOWTIE2_BUILD.out.index
                input[2] = [ [:], [] ]
                input[3] = false
                input[4] = true
                """
            }
        }

        run("BOWTIE2_ALIGN", alias: "ALIGN_INPUT") {
            script "../../../nf-core/bowtie2/align/main.nf"
            process {
                """
                input[0] = [
                    [ id:'spt5_input', single_end:false ], // meta map
                    [
                        file('https://raw.githubusercontent.com/nf-core/test-datasets/chipseq/testdata/SRR5204809_Spt5-ChIP_Input1_SacCer_ChIP-Seq_ss100k_R1.fastq.gz', checkIfExists: true),
                        file('https://raw.githubusercontent.com/nf-core/test-datasets/chipseq/testdata/SRR5204809_Spt5-ChIP_Input1_SacCer_ChIP-Seq_ss100k_R2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = BOWTIE2_BUILD.out.index
                input[2] = [ [:], [] ]
                input[3] = false
                input[4] = true
                """
            }
        }

        run("SUBREAD_FEATURECOUNTS") {
            script "../../../nf-core/subread/featurecounts/main.nf"
            process {
                """
                input[0] = ALIGN_T0.out.bam.map { meta, bam -> bam }
                    .mix(ALIGN_INPUT.out.bam.map { meta, bam -> bam })
                    .collect()
                    .map { bams -> [
                        [ id:'test', single_end:false ],
                        bams,
                        file('https://raw.githubusercontent.com/nf-core/test-datasets/626c8fab639062eade4b10747e919341cbf9b41a/reference/genes.gtf', checkIfExists: true)
                    ] }
                """
            }
        }

    }

    test("saccharomyces_cerevisiae - 2 samples - deseq2 pca and clustering qc") {

        when {
            process {
                """
                input[0] = SUBREAD_FEATURECOUNTS.out.counts
                input[1] = file("${projectDir}/assets/multiqc/deseq2_pca_header.txt", checkIfExists: true)
                input[2] = file("${projectDir}/assets/multiqc/deseq2_clustering_header.txt", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.pca_txt[0]).name,
                    file(process.out.dists_txt[0]).name,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("saccharomyces_cerevisiae - 2 samples - deseq2 pca and clustering qc - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = SUBREAD_FEATURECOUNTS.out.counts
                input[1] = file("${projectDir}/assets/multiqc/deseq2_pca_header.txt", checkIfExists: true)
                input[2] = file("${projectDir}/assets/multiqc/deseq2_clustering_header.txt", checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

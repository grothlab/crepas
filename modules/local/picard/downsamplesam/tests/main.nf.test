nextflow_process {

    name "Test Process PICARD_DOWNSAMPLESAM"
    script "../main.nf"
    process "PICARD_DOWNSAMPLESAM"

    tag "modules"
    tag "modules_local"
    tag "picard/downsamplesam"

    test("sarscov2 - bam - downsample") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false, downsampling_prob:0.5 ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'genome' ], // meta2 map
                    [],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.bam[0][1]).name,
                    file(process.out.index[0][1]).name,
                    file(process.out.metrics[0][1]).name,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - bam - no downsampling, symlink through") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false, downsampling_prob:1 ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'genome' ], // meta2 map
                    [],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    file(process.out.bam[0][1]).name,
                    file(process.out.index[0][1]).name,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - bam - downsample - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false, downsampling_prob:0.5 ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'genome' ], // meta2 map
                    [],
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

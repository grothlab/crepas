nextflow_process {

    name "Test Process MACE_MACE"
    script "../main.nf"
    process "MACE_MACE"

    tag "modules"
    tag "modules_local"
    tag "mace_mace"
    tag "find/concatenate"

    // No real-run test: mace.py hardcodes a minimum of 30 border-pair clusters before it will
    // produce any output (sys.exit(1) below that, no CLI override exists). No small real dataset
    // can clear that bar, so only stub coverage is practical here.
    setup {
        run("FIND_CONCATENATE", alias: "CAT_FORWARD_BW") {
            script "../../../../nf-core/find/concatenate/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test_forward' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bigwig/test.bigwig', checkIfExists: true)
                ]
                """
            }
        }

        run("FIND_CONCATENATE", alias: "CAT_REVERSE_BW") {
            script "../../../../nf-core/find/concatenate/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test_reverse' ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bigwig/test.bigwig', checkIfExists: true)
                ]
                """
            }
        }
    }

    test("sarscov2 - bigwig - border detection and pairing - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = CAT_FORWARD_BW.out.file_out
                    .map { meta, bw -> bw }
                    .combine( CAT_REVERSE_BW.out.file_out.map { meta, bw -> bw } )
                    .map { fwd_bw, rev_bw -> [ [ id:'test' ], fwd_bw, rev_bw ] }
                input[1] = [
                    [ id:'sarscov2' ], // meta2 map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.sizes', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

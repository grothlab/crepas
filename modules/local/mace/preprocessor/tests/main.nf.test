nextflow_process {

    name "Test Process MACE_PREPROCESSOR"
    script "../main.nf"
    process "MACE_PREPROCESSOR"

    tag "modules"
    tag "modules_local"
    tag "mace_preprocessor"
    tag "samtools/index"

    setup {
        run("SAMTOOLS_INDEX") {
            script "../../../../nf-core/samtools/index/main.nf"
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                ]
                """
            }
        }
    }

    test("sarscov2 - bam - bai - wig preprocessing") {

        when {
            process {
                """
                input[0] = SAMTOOLS_INDEX.out.index
                    .map { meta, bai -> [
                        meta,
                        [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true) ],
                        [ bai ]
                    ] }
                input[1] = [
                    [ id:'sarscov2' ], // meta2 map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.sizes', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.forward_wig,
                    process.out.reverse_wig,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                    ).match() }
            )
        }

    }

    test("sarscov2 - bam - bai - wig preprocessing - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = SAMTOOLS_INDEX.out.index
                    .map { meta, bai -> [
                        meta,
                        [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true) ],
                        [ bai ]
                    ] }
                input[1] = [
                    [ id:'sarscov2' ], // meta2 map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.sizes', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}

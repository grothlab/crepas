
process {
    withName: 'GROTHLAB_CREPAS:CREPAS:BAM_ALLOCATE_MULTIMAPPERS_(ENDO|EXO):SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${meta.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}.nsorted" }
        ext.args   = '-n'
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/bam_nsorted/" },
            mode: params.publish_dir_mode,
            pattern: '*.bam',
            enabled: params.save_allocation_intermeds
        ]
    }

    withName: 'GROTHLAB_CREPAS:CREPAS:BAM_ALLOCATE_MULTIMAPPERS_(ENDO|EXO):ALLO' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${meta.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}.allo" }
        //--ignore is used here to skip check for samtools collate in the bam header; samtools sort is used instead, but not detected
        ext.args =  { 
            [
                "--ignore",
                params.allo_mixed_cnn ? '--mixed' : '',
                meta.input_control ? '--random' : ''
            ].join(' ').trim()
        }
        publishDir = [
            [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.multimap_allocation_method}/" },
                mode: params.publish_dir_mode,
                pattern: "*.bam",
                enabled: params.save_allocation_intermeds
            ],
            [
                path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.multimap_allocation_method}/" },
                mode: params.publish_dir_mode,
                pattern: "*.log"    
            ]
        ]
    }

    withName: 'GROTHLAB_CREPAS:CREPAS:BAM_ALLOCATE_MULTIMAPPERS_(ENDO|EXO):MMR' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${meta.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}.mmr" }
        ext.args   = {
        [
            "--best-only",
            "--filter-dist 0",
            "--init-secondary"
        ].join(' ').trim()
    }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.multimap_allocation_method}/" },
            mode: params.publish_dir_mode,
            pattern: "*.bam",
            enabled: params.save_allocation_intermeds
        ]
    }

    withName: 'GROTHLAB_CREPAS:CREPAS:BAM_ALLOCATE_MULTIMAPPERS_(ENDO|EXO):BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${meta.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}.${params.multimap_allocation_method}.sorted" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.multimap_allocation_method}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_allocation_intermeds,
            pattern: '*.bam'

        ]
    }

    withName: 'GROTHLAB_CREPAS:CREPAS:BAM_ALLOCATE_MULTIMAPPERS_(ENDO|EXO):BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.multimap_allocation_method}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_allocation_intermeds
        ]
    }

    withName: 'GROTHLAB_CREPAS:CREPAS:BAM_ALLOCATE_MULTIMAPPERS_(ENDO|EXO):BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:SAMTOOLS_.*' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}.mLb.${meta.with_umi ? 'dedup' : 'mkD'}.flT1${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}.${params.multimap_allocation_method}.sorted" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/${params.multimap_allocation_method}/" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename },
            enabled: params.save_allocation_intermeds
        ]
    }
}


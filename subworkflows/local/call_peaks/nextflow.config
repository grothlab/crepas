includeConfig "../../../subworkflows/local/bam_peaks_call_epic2/nextflow.config"
includeConfig "../../../subworkflows/local/bam_peaks_call_macs3/nextflow.config"
includeConfig "../../../subworkflows/local/bam_peaks_call_genrich/nextflow.config"
includeConfig "../../../subworkflows/local/bam_peaks_call_mace/nextflow.config"
includeConfig "../../../subworkflows/local/bam_peaks_call_danpos2/nextflow.config"
includeConfig "../../../subworkflows/local/bam_peaks_call_consenrich_rocco/nextflow.config"
includeConfig "../../../subworkflows/local/bed_consensus_quantify_qc_bedtools_featurecounts_deseq2/nextflow.config"
includeConfig "../../../subworkflows/local/bam_peaks_call_seacr/nextflow.config"
includeConfig "../../../subworkflows/local/bam_peaks_call_lanceotron/nextflow.config"
includeConfig "../../../subworkflows/local/bam_peaks_qc_annotate_homer/nextflow.config"

process {
    withName: 'DENOPA' {
        ext.prefix = {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            "${params.multimap_allocation_method == 'chromap' ? '.cm_allo' : ''}" +
            ".mLb" +
            "${params.multimap_allocation_method ? '.' + (params.multimap_allocation_method == 'chromap' ? 'cm_allo' : params.multimap_allocation_method) : ''}" +
            "${meta.with_umi ? '.dedup' : !params.skip_markduplicates ? '.mkD' : ''}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${meta.exp_type == 'ATAC-seq' ? '.shifted' : ''}" +
            "${!params.skip_flT3 ? '.flT3' : ''}" +
            "${meta.flTbl_total_mapped_reads ? !meta.single_end ? '.flTbl.rmO' : '.flTbl' : ''}" +
            "${meta.downsampling_method ? '.dSp_' + meta.downsampling_method : ''}" +
            "${(meta.downsampling_method && meta.is_input_control) ? '_ref_' + meta.input_control_of_antibody : ''}"
        }
        publishDir = [
            path: {
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.multimap_allocation_method ? (params.multimap_allocation_method != 'chromap' ? params.multimap_allocation_method : '') : ''}" +
                "/${meta.exp_type}" +
                "${meta.downsampling_method ? '/downsampled' : ''}" +
                "/denopa/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'EDD' {
        // Skip a sample when EDD exits 1 because no bin size gives enough informative bins
        // (see --edd_required_fraction_of_informative_bins and --edd_max_ci_value)
        errorStrategy = { task.exitStatus == 1 ? 'ignore' : 'terminate' }
        ext.prefix = {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            "${params.multimap_allocation_method == 'chromap' ? '.cm_allo' : ''}" +
            ".mLb" +
            "${params.multimap_allocation_method ? '.' + (params.multimap_allocation_method == 'chromap' ? 'cm_allo' : params.multimap_allocation_method) : ''}" +
            "${meta.with_umi ? '.dedup' : !params.skip_markduplicates ? '.mkD' : ''}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${meta.exp_type == 'ATAC-seq' ? '.shifted' : ''}" +
            "${!params.skip_flT3 ? '.flT3' : ''}" +
            "${meta.flTbl_total_mapped_reads ? !meta.single_end ? '.flTbl.rmO' : '.flTbl' : ''}" +
            "${meta.downsampling_method ? '.dSp_' + meta.downsampling_method : ''}" +
            "${(meta.downsampling_method && meta.is_input_control) ? '_ref_' + meta.input_control_of_antibody : ''}"
        }
        ext.args  = { [
            params.edd_bin_size ? "--bin-size ${params.edd_bin_size}" : "",
            params.edd_gap_penalty ? "--gap-penalty ${params.edd_gap_penalty}" : "",
            "--num-trials ${params.edd_num_trials}",
            "--fdr ${params.edd_fdr}",
            "--max_CI_value ${params.edd_max_ci_value}",
            "--required_fraction_of_informative_bins ${params.edd_required_fraction_of_informative_bins}",
            "--p_hat_CI_method ${params.edd_p_hat_ci_method}",
            "--log_ratio_bin_size ${params.edd_log_ratio_bin_size}",
            "--write-log-ratios",
            "--write-bin-scores"
        ].join(' ').trim() }
        publishDir = [
            path: {
                "${params.outdir}/${params.aligner}/mergedLibrary/" +
                "${params.multimap_allocation_method ? (params.multimap_allocation_method != 'chromap' ? params.multimap_allocation_method : '') : ''}" +
                "/${meta.exp_type}" +
                "${meta.downsampling_method ? '/downsampled' : ''}" +
                "/edd/"
            },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
}


process {
    withName: 'SEACR_CALLPEAK' {
        ext.prefix = {
            "${meta.id}" +
            "${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : ''}" +
            "${params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}" +
            "${params.multimap_allocation_method == 'chromap' ? '.cm_allo' : ''}" +
            ".mLb" +
            "${params.multimap_allocation_method ? '.' + (params.multimap_allocation_method == 'chromap' ? 'cm_allo' : params.multimap_allocation_method) : ''}" +
            "${meta.with_umi ? '.dedup' : !params.skip_markduplicates ? '.mkD' : ''}" +
            ".flT1" +
            "${params.spikein_genome ? '.' + meta.genome + '.flT2' : ''}" +
            "${meta.exp_type == 'ATAC-seq' ? '.shifted' : ''}" +
            "${!params.skip_flT3 ? '.flT3' : ''}" +
            "${meta.flTbl_total_mapped_reads ? !meta.single_end ? '.flTbl.rmO' : '.flTbl' : ''}" +
            "${meta.downsampling_method ? '.dSp_' + meta.downsampling_method : ''}" +
            "${(meta.downsampling_method && meta.is_input_control) ? '_ref_' + meta.input_control_of_antibody : ''}" +
            ".${meta.seacr_bin_size}" +
            ".${meta.norm_factor_type}" +
            "${meta.seacr_bin_size == params.coverage_bin_size && meta.norm_factor_type == 'raw' ? '.map' : ''}"
        }
        // SEACR compares IP and input control signal directly: it normalises the control to the IP ('norm') for raw
        // tracks, which are not on the same scale, and compares the normalised rpm, srpm and cisrpm tracks as they are ('non')
        ext.args   = { "${meta.norm_factor_type == 'raw' ? 'norm' : 'non'} ${params.seacr_stringency}" }
        publishDir = [
            path: {
                    "${params.outdir}/${params.aligner}/mergedLibrary/" +
                    "${params.multimap_allocation_method ? (params.multimap_allocation_method != 'chromap' ? params.multimap_allocation_method : '') : ''}" +
                    "/${meta.exp_type}" +
                    "${meta.downsampling_method ? '/downsampled' : ''}" +
                    "/SEACR/"
            },
            mode: params.publish_dir_mode,
            pattern: '*.bed',
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // 1 bp coverage, once per BAM file: of paired-end fragments, or of single-end reads extended to --fragment_size
    withName: '.*:BAM_PEAKS_CALL_SEACR:BEDTOOLS_GENOMECOV' {
        ext.args   = { meta.single_end ? "-bg${params.fragment_size ? ' -fs ' + params.fragment_size : ''}" : '-bg -pc' }
        ext.prefix = {
            "${meta.id}" +
            "${(meta.downsampling_method && meta.is_input_control) ? '_ref_' + meta.input_control_of_antibody : ''}" +
            ".1bp"
        }
        publishDir = [
            enabled: false
        ]
    }

    // 1 bp coverage scaled by the factor of each normalisation (the coverage tracks are scaled already), and a
    // header line for all bedGraphs, because SEACR skips the first line
    withName: '.*:BAM_PEAKS_CALL_SEACR:BEDGRAPH_NORMALIZE' {
        ext.args2  = { "--norm_factor ${meta.seacr_bin_size == params.coverage_bin_size ? 1 : meta.norm_factor_val} --norm_operation multiply --track_line" }
        ext.prefix = {
            "${meta.id}" +
            "${meta.is_input_control ? '_ref_' + meta.input_control_of_antibody : ''}" +
            ".${meta.seacr_bin_size}bp.${meta.norm_factor_type}"
        }
        publishDir = [
            enabled: false
        ]
    }
}

        ]
    }

    withName: 'GROTHLAB_CREPAS:CREPAS:BAM_FILTER_SAMBAMBA_FLT3:BAM_SORT_STATS_SAMTOOLS_FLT:BAM_STATS_SAMTOOLS:.*' {
        ext.prefix = { 

            mode: params.publish_dir_mode,
            pattern: '*.bam'
        ]
    }

    withName: 'GROTHLAB_CREPAS:CREPAS:BAM_FILTER_SAMBAMBA_FLT3:BAM_SORT_STATS_SAMTOOLS_FLT:SAMTOOLS_INDEX' {
        publishDir = [

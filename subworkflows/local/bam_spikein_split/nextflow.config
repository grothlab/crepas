
process {
    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_SPIKEIN_SPLIT:BAM_SPLIT_BY_GENOME_ENDO' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.multimap_allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1" }
        publishDir = [
            path: { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split" },
            mode: params.publish_dir_mode,
            pattern: '*.bam',
            enabled: params.save_spikein_intermeds

        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_SPIKEIN_SPLIT:BAM_SPLIT_BY_GENOME_EXO' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.multimap_allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1" }
        publishDir = [
            path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split" },
            mode : params.publish_dir_mode,
            pattern : '*.bam',
            enabled: params.save_spikein_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_SPIKEIN_SPLIT:SAMTOOLS_INDEX' {
        publishDir = [
            path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split" },
            mode: params.publish_dir_mode,
            pattern: '*.{bai,csi,crai}',
            enabled: params.save_spikein_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_SPIKEIN_SPLIT:SAMBAMBA_VIEW' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.multimap_allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1.${meta.genome}.flT2" }
        ext.args = {
            [
            meta.single_end ?
                (params.with_umi ? "" : "-F 'not duplicate'") :
                    (params.with_umi ? "-F 'paired and proper_pair and not (unmapped or mate_is_unmapped)'" :
                        "-F 'not duplicate and paired and proper_pair and not (unmapped or mate_is_unmapped)'"),
            "--format bam"
        ].join(' ').trim()
        }
        publishDir = [
            path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split/flT2" },
            mode : params.publish_dir_mode,
            pattern : '*.bam',
            enabled: params.save_spikein_intermeds
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_SPIKEIN_SPLIT:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.multimap_allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1.${meta.genome}.flT2.sorted" }
        publishDir = [
            path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split/flT2" },
            mode: params.publish_dir_mode,
            pattern: '*.bam'
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_SPIKEIN_SPLIT:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_INDEX' {
        publishDir = [
            path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split/flT2" },
            mode: params.publish_dir_mode,
            pattern: '*.{bai,csi,crai}'
        ]
    }

    withName: 'GROTHLAB_GLSEQ:GLSEQ:BAM_SPIKEIN_SPLIT:BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:.*' {
        ext.prefix = { "${meta.id}${params.hardtrim5_length ? '.' + params.hardtrim5_length + 'bp_5prime' : params.hardtrim3_length ? '.' + params.hardtrim3_length + 'bp_3prime' : ''}${params.multimap_allocation_method == 'chromap' ? '.cm_allo' : ''}.mLb.${params.with_umi ? 'dedup' : 'mkD'}.flT1.${meta.genome}.flT2.sorted" }
        publishDir = [
            path : { "${params.outdir}/${params.aligner}/mergedLibrary/spikein_split/flT2" },
            mode: params.publish_dir_mode,
            pattern: "*.{stats,flagstat,idxstats}"
        ]
    }
}

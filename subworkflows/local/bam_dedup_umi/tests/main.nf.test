nextflow_workflow {

    name "Test Workflow BAM_DEDUP_UMI"
    script "../main.nf"
    workflow "BAM_DEDUP_UMI"
    config "./nextflow.config"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/bam_dedup_umi"
    tag "subworkflows/bam_dedup_stats_samtools_umicollapse"
    tag "subworkflows/bam_dedup_stats_samtools_umitools"
    tag "subworkflows/bam_sort_stats_samtools"
    tag "umitools/prepareforrsem"
    tag "samtools/sort"
    tag "samtools/faidx"

    setup {
        run("SAMTOOLS_FAIDX") {
            script "../../../../modules/nf-core/samtools/faidx/main.nf"
            process {
                """
                input[0] = Channel.of([
                    [ id:'transcriptome' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true),
                    []
                ])
                input[1] = false
                """
            }
        }
    }

    test("umitools - with transcriptome bam - skip_split_by_chrom") {

        when {
            workflow {
                """
                input[0] = [
                    [ id:'test'], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam.bai', checkIfExists: true)
                ]
                input[1] = Channel.of([[:], []]) // ch_chrom_sizes, unused when skip_split_by_chrom is true
                input[2] = [
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true)
                ]
                input[3] = 'umitools' // umi_dedup_tool
                input[4] = false      // umitools_dedup_stats
                input[5] = [
                    [ id:'test'], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam', checkIfExists: true)
                ]
                input[6] = SAMTOOLS_FAIDX.out.fai.map { meta, fai -> [ [id:'transcriptome'], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true), fai ] }
                input[7] = true // skip_split_by_chrom
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bam.get(0).get(1) ==~ ".*.bam" },
                { assert workflow.out.index.get(0).get(1) ==~ ".*.bai" },
                { assert workflow.out.transcriptome_bam.get(0).get(1) ==~ ".*.bam" },
                { assert snapshot(
                    workflow.out.stats,
                    workflow.out.flagstat,
                    workflow.out.idxstats
                ).match() }
            )
        }
    }

    test("umicollapse - no transcriptome bam - skip_split_by_chrom") {

        when {
            workflow {
                """
                input[0] = [
                    [ id:'test'], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam.bai', checkIfExists: true)
                ]
                input[1] = Channel.of([[:], []]) // ch_chrom_sizes, unused when skip_split_by_chrom is true
                input[2] = [
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true)
                ]
                input[3] = 'umicollapse' // umi_dedup_tool
                input[4] = false         // umitools_dedup_stats
                input[5] = Channel.empty()
                input[6] = Channel.empty()
                input[7] = true // skip_split_by_chrom
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.bam.get(0).get(1) ==~ ".*.bam" },
                { assert workflow.out.index.get(0).get(1) ==~ ".*.bai" },
                { assert snapshot(
                    workflow.out.stats,
                    workflow.out.flagstat,
                    workflow.out.idxstats
                ).match() }
            )
        }
    }

    test("umitools - with transcriptome bam - skip_split_by_chrom - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = [
                    [ id:'test'], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam.bai', checkIfExists: true)
                ]
                input[1] = Channel.of([[:], []])
                input[2] = [
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true)
                ]
                input[3] = 'umitools'
                input[4] = false
                input[5] = [
                    [ id:'test'], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam', checkIfExists: true)
                ]
                input[6] = SAMTOOLS_FAIDX.out.fai.map { meta, fai -> [ [id:'transcriptome'], file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/transcriptome.fasta', checkIfExists: true), fai ] }
                input[7] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }

    test("umicollapse - no transcriptome bam - skip_split_by_chrom - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = [
                    [ id:'test'], // meta map
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.umi.sorted.bam.bai', checkIfExists: true)
                ]
                input[1] = Channel.of([[:], []])
                input[2] = [
                    [ id:'genome' ],
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/genome.fasta.fai', checkIfExists: true)
                ]
                input[3] = 'umicollapse'
                input[4] = false
                input[5] = Channel.empty()
                input[6] = Channel.empty()
                input[7] = true
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() }
            )
        }
    }
}

nextflow_workflow {

    name "Test Subworkflow FASTQ_FASTQC_UMITOOLS_UMITRANSFER_TRIMGALORE"
    script "../main.nf"
    config "./nextflow.config"
    workflow "FASTQ_FASTQC_UMITOOLS_UMITRANSFER_TRIMGALORE"

    tag "subworkflows"
    tag "subworkflows_nfcore"
    tag "subworkflows/fastq_fastqc_umitools_umitransfer_trimgalore"
    tag "fastqc"
    tag "fastq_extract_spikein_barcodes"
    tag "umitools/extract"
    tag "umitransfer"
    tag "trimgalore"

    test("single_end_no_umi") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true ], // meta map
                    [ file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true) ]
                ])
                input[1] = false           // skip_fastqc
                input[2] = true            // skip_spikein_barcode_extract
                input[3] = Channel.of([[:], []]) // ch_spikein_barcode_table
                input[4] = false           // skip_trimming
                input[5] = 0               // umi_discard_read
                input[6] = 1               // min_trimmed_reads
                input[7] = 0               // hardtrim3_length
                input[8] = 0               // hardtrim5_length
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert path(workflow.out.fastqc_html[0][1]).text.contains("<tr><td>File type</td><td>Conventional base calls</td></tr>") },
                { assert snapshot(
                    workflow.out.reads,
                    workflow.out.trim_read_count,
                    workflow.out.trim_unpaired
                ).match() }
            )
        }
    }

    test("paired_end_umitools_extract") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false, extract_umi:true ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = false           // skip_fastqc
                input[2] = true            // skip_spikein_barcode_extract
                input[3] = Channel.of([[:], []]) // ch_spikein_barcode_table
                input[4] = false           // skip_trimming
                input[5] = 0               // umi_discard_read
                input[6] = 1               // min_trimmed_reads
                input[7] = 0               // hardtrim3_length
                input[8] = 0               // hardtrim5_length
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.no_sep_umi_fq_log.size() == 1 },
                { assert snapshot(
                    workflow.out.reads,
                    workflow.out.trim_read_count,
                    workflow.out.trim_unpaired
                ).match() }
            )
        }
    }

    test("single_end_umitransfer_sep_umi_fq") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:true, sep_umi_fq:true ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = false           // skip_fastqc
                input[2] = true            // skip_spikein_barcode_extract
                input[3] = Channel.of([[:], []]) // ch_spikein_barcode_table
                input[4] = false           // skip_trimming
                input[5] = 0               // umi_discard_read
                input[6] = 1               // min_trimmed_reads
                input[7] = 0               // hardtrim3_length
                input[8] = 0               // hardtrim5_length
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.sep_umi_fq_log.size() == 1 },
                { assert snapshot(
                    workflow.out.reads,
                    workflow.out.trim_read_count,
                    workflow.out.trim_unpaired
                ).match() }
            )
        }
    }

    test("paired_end_with_spikein_barcode_extract_and_hardtrim") {

        when {
            params {
                // TRIMGALORE_HARDTRIM's ext.args reads params.hardtrim5_length directly (not the
                // subworkflow's own hardtrim5_length take: value), matching how the real pipeline
                // always passes params.hardtrim5_length in as that take: argument too.
                hardtrim5_length = 10
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = true            // skip_fastqc
                input[2] = false           // skip_spikein_barcode_extract
                input[3] = Channel.of([
                    [ id:'spikein_barcodes' ],
                    file('https://raw.githubusercontent.com/grothlab/crepas/6d7eb52e32f7e83e7e43664ae9ed955f51e68171/assets/barcodes/sc_spikein_barcodes.tsv', checkIfExists: true)
                ])
                input[4] = false           // skip_trimming
                input[5] = 0               // umi_discard_read
                input[6] = 1               // min_trimmed_reads
                input[7] = 0               // hardtrim3_length
                input[8] = 10              // hardtrim5_length
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.barcode_counts.size() == 1 },
                // TrimGalore's --hardtrim5/--hardtrim3 modes just chop bases and don't run
                // adapter/quality trimming, so no *_trimming_report.txt (htrim_log) is produced.
                { assert workflow.out.reads[0][1][0] ==~ ".*10bp_5prime.*" },
                { assert snapshot(
                    workflow.out.reads,
                    workflow.out.barcode_counts,
                    workflow.out.trim_read_count
                ).match() }
            )
        }
    }

    test("skip_all_steps") {

        when {
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_1.fastq.gz', checkIfExists: true),
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/fastq/test_2.fastq.gz', checkIfExists: true)
                    ]
                ])
                input[1] = true            // skip_fastqc
                input[2] = true            // skip_spikein_barcode_extract
                input[3] = Channel.of([[:], []]) // ch_spikein_barcode_table
                input[4] = true            // skip_trimming
                input[5] = 0               // umi_discard_read
                input[6] = 1               // min_trimmed_reads
                input[7] = 0               // hardtrim3_length
                input[8] = 0               // hardtrim5_length
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success }
                // No snapshot when skipping all steps, as output is input
            )
        }
    }


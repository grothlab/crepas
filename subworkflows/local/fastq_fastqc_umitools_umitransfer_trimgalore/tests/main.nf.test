                input[3] = Channel.of([[:], []]) // ch_spikein_barcode_table
                input[4] = false           // skip_trimming
                input[5] = 0               // umi_discard_read
                input[6] = 1               // min_trimmed_reads
                input[7] = 0               // hardtrim3_length

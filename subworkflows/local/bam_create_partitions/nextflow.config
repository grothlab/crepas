            },
            mode: params.publish_dir_mode,
            pattern: "*.{pdf,png,tsv}"
        ]
    }
    
    withName: 'GROTHLAB_CREPAS:CREPAS:BAM_CREATE_PARTITIONS:UCSC_BEDGRAPHTOBIGWIG_PARTITIONS' {
        ext.prefix = {
